---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import CorporateIntro from '../../components/CorporateIntro.astro';
import Services from '../../components/Services.astro';
import AboutUs from '../../components/AboutUs.astro';
import VideoGallery from '../../components/VideoGallery.astro';
import Process from '../../components/Process.astro';
import WhyUs from '../../components/WhyUs.astro';
import Testimonials from '../../components/Testimonials.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
  ];
}

const lang = (Astro.params.lang as Lang) || 'en';
const t = useTranslations(lang);
---

<Layout 
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
>
  <Header lang={lang} />
  <main class="flex-grow">
    <Hero lang={lang} />
    <CorporateIntro lang={lang} />
    <Services lang={lang} />
    <AboutUs lang={lang} />
    <VideoGallery lang={lang} />
    <Process lang={lang} />
    <WhyUs lang={lang} />
    <Testimonials lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
