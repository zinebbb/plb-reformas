---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PLB Reformas Premium S.L. | Reformas Integrales y Espacios a Medida",
  description = "Especialistas en reformas integrales, cocinas y baños de alta calidad. Compromiso, presupuesto cerrado y acabados impecables sin imprevistos."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo.jpeg" />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#FAF8F5] text-[#1F1D1A] min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] antialiased">
    <slot />

    <!-- Global Client Interactions: Subtle & High-Performance -->
    <script>
      // 1. Intersection Observer for Scroll Reveals
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));

      // 2. Dynamic Sticky Header Elevation on Scroll
      const header = document.querySelector('header');
      if (header) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 30) {
            header.classList.add('shadow-xs', 'bg-[#FAF8F5]/95');
            header.classList.remove('bg-[#FAF8F5]/90');
          } else {
            header.classList.remove('shadow-xs', 'bg-[#FAF8F5]/95');
            header.classList.add('bg-[#FAF8F5]/90');
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  .font-serif {
    font-family: 'Playfair Display', Georgia, serif;
  }
</style>
