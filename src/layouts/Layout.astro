---
import '../styles/global.css';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = (Astro.currentLocale as Lang) || 'es',
  title,
  description
} = Astro.props;

const t = useTranslations(lang);
const metaTitle = title || t.meta.title;
const metaDescription = description || t.meta.description;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content="/images/og-plb-reformas.jpg" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content="/images/og-plb-reformas.jpg" />
    
    <!-- Alternate hreflang tags for ES, EN & x-default -->
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />

    <!-- Preload Critical Local Fonts -->
    <link rel="preload" href="/fonts/fraunces-200.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-variable.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preload Hero Poster Image for immediate LCP -->
    <link rel="preload" as="image" href="/images/hero-benidorm-poster-mobile.webp" type="image/webp" media="(max-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/hero-benidorm-poster-desktop.webp" type="image/webp" media="(min-width: 769px)" fetchpriority="high" />
  </head>
  <body class="bg-white text-[#111317] min-h-screen flex flex-col font-['Outfit',sans-serif] antialiased">
    <slot />

    <!-- Global Scroll Observer -->
    <script>
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
