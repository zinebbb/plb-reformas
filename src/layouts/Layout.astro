---
import '../styles/global.css';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  lang = (Astro.currentLocale as Lang) || 'es',
  title,
  description
} = Astro.props;

const t = useTranslations(lang);
const metaTitle = title || t.meta.title;
const metaDescription = description || t.meta.description;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="generator" content={Astro.generator} />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content="/images/logo.jpeg" />
    <meta property="og:type" content="website" />
    
    <!-- Alternate hreflang tags for locales & x-default -->
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="x-default" href="/" />

    <!-- Google Fonts: Cormorant Garamond (Cyrillic support), Fraunces, Inter, Outfit & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Fraunces:opsz,wght@9..144,200&subset=cyrillic,latin,latin-ext&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Outfit:wght@200;300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-[#111317] min-h-screen flex flex-col font-['Montserrat',sans-serif] antialiased">
    <slot />

    <!-- Global Scroll Observer -->
    <script>
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(observerCallback, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
