---
---

<section id="antes-despues" class="py-24 bg-[#0f1115] text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Header -->
    <div class="fade-up text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest uppercase text-gold-500 block mb-2">
        TRANSFORMACIÓN REAL
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-white mb-4">
        Antes y Después de Obra
      </h2>
      <div class="w-16 h-1 bg-gold-500 mx-auto mb-5"></div>
      <p class="text-sm sm:text-base text-gray-400 leading-relaxed font-normal">
        Desliza el divisor central para comprobar cómo transformamos un piso antiguo de origen en Benidorm en una vivienda moderna y luminosa.
      </p>
    </div>

    <!-- Comparison Slider Widget -->
    <div class="fade-up delay-100 max-w-4xl mx-auto">
      <div 
        id="comparison-container"
        class="relative w-full aspect-[4/3] sm:aspect-[16/10] overflow-hidden select-none cursor-ew-resize bg-black rounded-sm border border-white/20 shadow-2xl"
      >
        
        <!-- BEFORE Image (Base) -->
        <img 
          src="/images/thumbnails/thumb-7.jpg" 
          alt="Vivienda de origen antes de la reforma" 
          class="absolute inset-0 w-full h-full object-cover pointer-events-none"
        />
        <div class="absolute top-4 left-4 z-10 px-3.5 py-1.5 font-bold text-xs uppercase tracking-wider bg-black/80 backdrop-blur-md text-white border border-white/20 rounded-xs">
          Antes / Origen
        </div>

        <!-- AFTER Image (Overlay) -->
        <div 
          id="comparison-after"
          class="absolute inset-0 overflow-hidden pointer-events-none"
          style="width: 50%;"
        >
          <img 
            src="/images/thumbnails/thumb-4.jpg" 
            alt="Reforma terminada por PLB Reformas" 
            class="absolute top-0 left-0 h-full max-w-none object-cover"
            style="width: 100%;"
          />
          <div class="absolute top-4 left-4 z-10 px-3.5 py-1.5 font-bold text-xs uppercase tracking-wider bg-gold-500 text-black border border-white/20 rounded-xs">
            Después / PLB Reformas
          </div>
        </div>

        <!-- Draggable Handle Divider -->
        <div 
          id="comparison-handle"
          class="absolute top-0 bottom-0 z-20 w-1 bg-white pointer-events-none shadow-[0_0_15px_rgba(0,0,0,0.6)]"
          style="left: 50%;"
        >
          <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-black border-2 border-gold-500 shadow-xl flex items-center justify-center text-white text-xs">
            <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l-4 3 4 3m8-6l4 3-4 3"></path>
            </svg>
          </div>
        </div>

      </div>

      <!-- Caption -->
      <div class="mt-4 flex items-center justify-between text-xs text-gray-400 uppercase tracking-wider px-2">
        <span>← Estado Inicial</span>
        <span class="text-gold-500 font-bold">Desliza para comparar</span>
        <span>Resultado Final →</span>
      </div>
    </div>

  </div>
</section>

<script>
  const container = document.getElementById('comparison-container');
  const afterLayer = document.getElementById('comparison-after');
  const handle = document.getElementById('comparison-handle');
  const afterImg = afterLayer?.querySelector('img') as HTMLImageElement | null;

  if (container && afterLayer && handle && afterImg) {
    let isDragging = false;

    const setPosition = (xPos: number) => {
      const rect = container.getBoundingClientRect();
      let offsetX = xPos - rect.left;
      if (offsetX < 0) offsetX = 0;
      if (offsetX > rect.width) offsetX = rect.width;

      const percentage = (offsetX / rect.width) * 100;
      afterLayer.style.width = `${percentage}%`;
      handle.style.left = `${percentage}%`;
      afterImg.style.width = `${rect.width}px`;
    };

    const updateSize = () => {
      const rect = container.getBoundingClientRect();
      afterImg.style.width = `${rect.width}px`;
    };
    window.addEventListener('resize', updateSize);
    updateSize();

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      setPosition(e.clientX);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      setPosition(e.clientX);
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    container.addEventListener('touchstart', (e) => {
      isDragging = true;
      if (e.touches[0]) setPosition(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isDragging || !e.touches[0]) return;
      setPosition(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchend', () => {
      isDragging = false;
    });
  }
</script>
