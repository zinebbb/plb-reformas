---
---

<section id="calculadora" class="py-24 bg-[#f8fafc] text-[#111317] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-8">
    
    <!-- Header -->
    <div class="fade-up text-center mb-16">
      <span class="text-xs font-bold tracking-widest uppercase text-gold-600 block mb-2">
        TRANSPARENCIA TOTAL
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[#111317] mb-4">
        Calculadora de Presupuesto
      </h2>
      <div class="w-16 h-1 bg-gold-500 mx-auto mb-5"></div>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
        Calcula una primera estimación orientativa para tu vivienda en Benidorm o Costa Blanca en menos de un minuto.
      </p>
    </div>

    <!-- Estimator Box -->
    <div class="fade-up delay-100 bg-white p-8 sm:p-12 rounded-sm border border-gray-200 shadow-xl">
      
      <!-- 1. Type -->
      <div class="mb-10">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-3">
          1. Tipo de Reforma
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <button 
            type="button" 
            data-type="integral" 
            data-price="680" 
            class="calc-type-btn active px-4 py-3 rounded-sm border-2 border-gold-500 bg-black text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Piso Integral
          </button>
          <button 
            type="button" 
            data-type="chalet" 
            data-price="780" 
            class="calc-type-btn px-4 py-3 rounded-sm border border-gray-300 bg-white text-gray-700 hover:border-gold-500 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Chalet / Villa
          </button>
          <button 
            type="button" 
            data-type="cocina" 
            data-price="850" 
            class="calc-type-btn px-4 py-3 rounded-sm border border-gray-300 bg-white text-gray-700 hover:border-gold-500 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Cocina a Medida
          </button>
          <button 
            type="button" 
            data-type="bano" 
            data-price="750" 
            class="calc-type-btn px-4 py-3 rounded-sm border border-gray-300 bg-white text-gray-700 hover:border-gold-500 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Baño Completo
          </button>
        </div>
      </div>

      <!-- 2. Slider -->
      <div class="mb-10">
        <div class="flex items-center justify-between mb-3">
          <label class="text-xs font-bold uppercase tracking-wider text-gray-700">
            2. Superficie Aproximada
          </label>
          <div class="text-lg font-extrabold text-gold-600">
            <span id="meters-display">85</span> m²
          </div>
        </div>
        <input 
          id="meters-slider" 
          type="range" 
          min="20" 
          max="250" 
          value="85" 
          step="5"
          class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-gold-500"
        />
        <div class="flex justify-between text-xs text-gray-400 mt-2 font-medium">
          <span>20 m² (Apartamento / Baño)</span>
          <span>85 m² (Piso medio en Benidorm)</span>
          <span>250 m² (Villa amplia)</span>
        </div>
      </div>

      <!-- 3. Quality -->
      <div class="mb-12">
        <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-3">
          3. Nivel de Calidades
        </label>
        <div class="grid grid-cols-3 gap-3">
          <button 
            type="button" 
            data-quality="1.0" 
            class="calc-quality-btn px-4 py-3 rounded-sm border border-gray-300 bg-white text-gray-700 hover:border-gold-500 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Confort
          </button>
          <button 
            type="button" 
            data-quality="1.25" 
            class="calc-quality-btn active px-4 py-3 rounded-sm border-2 border-gold-500 bg-black text-white text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Alta Gama
          </button>
          <button 
            type="button" 
            data-quality="1.5" 
            class="calc-quality-btn px-4 py-3 rounded-sm border border-gray-300 bg-white text-gray-700 hover:border-gold-500 text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-center"
          >
            Premium / Lujo
          </button>
        </div>
      </div>

      <!-- Calculation Result Strip -->
      <div class="p-8 bg-[#111317] text-white rounded-sm border-l-4 border-gold-500 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md">
        <div>
          <span class="text-xs uppercase tracking-wider text-gold-400 font-bold block mb-1">
            Rango Estimado Orientativo
          </span>
          <div class="text-3xl sm:text-4xl font-extrabold text-white">
            <span id="price-min">42.000</span> € — <span id="price-max">49.000</span> €
          </div>
          <p class="text-[11px] text-gray-400 mt-1 font-light">
            *Incluye mano de obra especializada, coordinación técnica y materiales.
          </p>
        </div>

        <button 
          id="apply-calc-btn"
          type="button"
          class="w-full sm:w-auto px-8 py-3.5 bg-gold-500 hover:bg-gold-400 text-black font-extrabold text-xs uppercase tracking-wider rounded-sm transition-colors cursor-pointer shrink-0"
        >
          Obtener Presupuesto Cerrado
        </button>
      </div>

    </div>

  </div>
</section>

<script>
  let basePricePerMeter = 680;
  let surfaceMeters = 85;
  let qualityMultiplier = 1.25;
  let selectedTypeName = "Piso Integral";

  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.calc-type-btn');
  const qualityButtons = document.querySelectorAll<HTMLButtonElement>('.calc-quality-btn');
  const slider = document.getElementById('meters-slider') as HTMLInputElement | null;
  const metersDisplay = document.getElementById('meters-display');
  const priceMinDisplay = document.getElementById('price-min');
  const priceMaxDisplay = document.getElementById('price-max');
  const applyBtn = document.getElementById('apply-calc-btn');

  const calculateEstimate = () => {
    const rawTotal = basePricePerMeter * surfaceMeters * qualityMultiplier;
    const minVal = Math.round((rawTotal * 0.9) / 100) * 100;
    const maxVal = Math.round((rawTotal * 1.1) / 100) * 100;

    if (priceMinDisplay && priceMaxDisplay) {
      priceMinDisplay.textContent = minVal.toLocaleString('es-ES');
      priceMaxDisplay.textContent = maxVal.toLocaleString('es-ES');
    }
  };

  typeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeButtons.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-gold-500', 'bg-black', 'text-white');
        b.classList.add('border', 'border-gray-300', 'bg-white', 'text-gray-700');
      });
      btn.classList.add('active', 'border-2', 'border-gold-500', 'bg-black', 'text-white');
      btn.classList.remove('border', 'border-gray-300', 'bg-white', 'text-gray-700');

      basePricePerMeter = Number(btn.getAttribute('data-price') || '680');
      selectedTypeName = btn.textContent?.trim() || "Reforma";
      calculateEstimate();
    });
  });

  if (slider && metersDisplay) {
    slider.addEventListener('input', () => {
      surfaceMeters = Number(slider.value);
      metersDisplay.textContent = String(surfaceMeters);
      calculateEstimate();
    });
  }

  qualityButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      qualityButtons.forEach((b) => {
        b.classList.remove('active', 'border-2', 'border-gold-500', 'bg-black', 'text-white');
        b.classList.add('border', 'border-gray-300', 'bg-white', 'text-gray-700');
      });
      btn.classList.add('active', 'border-2', 'border-gold-500', 'bg-black', 'text-white');
      btn.classList.remove('border', 'border-gray-300', 'bg-white', 'text-gray-700');

      qualityMultiplier = Number(btn.getAttribute('data-quality') || '1.25');
      calculateEstimate();
    });
  });

  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const contactSection = document.getElementById('contacto');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth' });

        const textarea = contactSection.querySelector('textarea');
        if (textarea) {
          const minText = priceMinDisplay?.textContent || '';
          const maxText = priceMaxDisplay?.textContent || '';
          textarea.value = `Hola, he utilizado la calculadora web de PLB Reformas Benidorm: solicito valoración técnica para ${selectedTypeName} de aproximadamente ${surfaceMeters} m² (estimación web orientativa: ${minText}€ - ${maxText}€).`;
          textarea.focus();
        }
      }
    });
  }

  calculateEstimate();
</script>
