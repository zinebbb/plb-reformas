---
---

<section id="calculadora" class="py-24 bg-[#F4EFE8] border-y border-[#EAE3D7] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="fade-up text-center mb-12">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Transparencia & Estimación</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-3">
        Calculadora orientativa de reforma
      </h2>
      <p class="text-[#57534E] text-base leading-relaxed max-w-xl mx-auto">
        Obtén una primera aproximación de tu presupuesto en segundos según los metros y el tipo de trabajo.
      </p>
    </div>

    <!-- Interactive Card -->
    <div class="fade-up delay-100 bg-white p-8 sm:p-10 rounded-3xl border border-[#EAE3D7] shadow-sm">
      
      <!-- 1. Reform Type Selector -->
      <div class="mb-8">
        <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-3">1. Tipo de Intervención</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <button 
            type="button" 
            data-type="integral" 
            data-price="650" 
            class="calc-type-btn active px-4 py-3 rounded-xl border border-[#1F1D1A] bg-[#1F1D1A] text-white text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center"
          >
            Reforma Integral
          </button>
          <button 
            type="button" 
            data-type="cocina" 
            data-price="850" 
            class="calc-type-btn px-4 py-3 rounded-xl border border-[#EAE3D7] bg-[#FAF8F5] text-[#57534E] hover:border-[#B58C42] text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center"
          >
            Cocina Completa
          </button>
          <button 
            type="button" 
            data-type="bano" 
            data-price="750" 
            class="calc-type-btn px-4 py-3 rounded-xl border border-[#EAE3D7] bg-[#FAF8F5] text-[#57534E] hover:border-[#B58C42] text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center"
          >
            Baño / Ducha
          </button>
          <button 
            type="button" 
            data-type="pintura" 
            data-price="220" 
            class="calc-type-btn px-4 py-3 rounded-xl border border-[#EAE3D7] bg-[#FAF8F5] text-[#57534E] hover:border-[#B58C42] text-xs sm:text-sm font-semibold transition-all cursor-pointer text-center"
          >
            Pintura & Suelos
          </button>
        </div>
      </div>

      <!-- 2. Surface Slider -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3">
          <label class="text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider">2. Superficie Aproximada</label>
          <div class="text-base font-bold text-[#9C7334]">
            <span id="meters-display">75</span> m²
          </div>
        </div>
        <input 
          id="meters-slider" 
          type="range" 
          min="15" 
          max="200" 
          value="75" 
          step="5"
          class="w-full h-2 bg-[#FAF8F5] rounded-lg appearance-none cursor-pointer accent-[#B58C42] border border-[#EAE3D7]"
        />
        <div class="flex justify-between text-[11px] text-[#A8A29E] mt-2">
          <span>15 m² (Estancia / Baño)</span>
          <span>80 m² (Piso medio)</span>
          <span>200 m² (Vivienda amplia)</span>
        </div>
      </div>

      <!-- 3. Quality Level Selector -->
      <div class="mb-10">
        <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-3">3. Nivel de Acabados</label>
        <div class="grid grid-cols-3 gap-3">
          <button 
            type="button" 
            data-quality="1.0" 
            class="calc-quality-btn px-4 py-3 rounded-xl border border-[#EAE3D7] bg-[#FAF8F5] text-[#57534E] hover:border-[#B58C42] text-xs sm:text-sm font-medium transition-all cursor-pointer text-center"
          >
            <span class="block font-semibold text-[#1F1D1A]">Estándar</span>
            <span class="block text-[11px] text-[#78716C] mt-0.5">Funcional y resistente</span>
          </button>
          <button 
            type="button" 
            data-quality="1.25" 
            class="calc-quality-btn active px-4 py-3 rounded-xl border border-[#1F1D1A] bg-[#1F1D1A] text-white text-xs sm:text-sm font-medium transition-all cursor-pointer text-center"
          >
            <span class="block font-semibold">Confort</span>
            <span class="block text-[11px] text-slate-300 mt-0.5">Equilibrio y diseño</span>
          </button>
          <button 
            type="button" 
            data-quality="1.5" 
            class="calc-quality-btn px-4 py-3 rounded-xl border border-[#EAE3D7] bg-[#FAF8F5] text-[#57534E] hover:border-[#B58C42] text-xs sm:text-sm font-medium transition-all cursor-pointer text-center"
          >
            <span class="block font-semibold text-[#1F1D1A]">Premium</span>
            <span class="block text-[11px] text-[#78716C] mt-0.5">Alta gama y detalle</span>
          </button>
        </div>
      </div>

      <!-- Calculation Result Box -->
      <div class="bg-[#FAF8F5] p-6 sm:p-8 rounded-2xl border border-[#EAE3D7] flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-[#78716C]">Rango Orientativo Estimado</span>
          <div class="text-3xl sm:text-4xl font-serif font-bold text-[#1F1D1A] mt-1">
            <span id="price-min">35.000</span> € — <span id="price-max">42.000</span> €
          </div>
          <p class="text-xs text-[#78716C] mt-1.5">
            *Incluye mano de obra especializada, materiales e IVA orientativo.
          </p>
        </div>

        <button 
          id="apply-calc-btn"
          type="button"
          class="w-full sm:w-auto px-7 py-3.5 rounded-full font-semibold text-white bg-[#1F1D1A] hover:bg-[#B58C42] shadow-xs hover:shadow-md transition-all text-xs sm:text-sm tracking-wide shrink-0 cursor-pointer text-center"
        >
          Pedir Visita con este Cálculo
        </button>
      </div>

    </div>

  </div>
</section>

<!-- Interactive Calculator Logic -->
<script>
  let basePricePerMeter = 650;
  let surfaceMeters = 75;
  let qualityMultiplier = 1.25;
  let selectedTypeName = "Reforma Integral";

  const typeButtons = document.querySelectorAll<HTMLButtonElement>('.calc-type-btn');
  const qualityButtons = document.querySelectorAll<HTMLButtonElement>('.calc-quality-btn');
  const slider = document.getElementById('meters-slider') as HTMLInputElement | null;
  const metersDisplay = document.getElementById('meters-display');
  const priceMinDisplay = document.getElementById('price-min');
  const priceMaxDisplay = document.getElementById('price-max');
  const applyBtn = document.getElementById('apply-calc-btn');

  const calculateEstimate = () => {
    const rawTotal = basePricePerMeter * surfaceMeters * qualityMultiplier;
    const minVal = Math.round((rawTotal * 0.9) / 100) * 100;
    const maxVal = Math.round((rawTotal * 1.1) / 100) * 100;

    if (priceMinDisplay && priceMaxDisplay) {
      priceMinDisplay.textContent = minVal.toLocaleString('es-ES');
      priceMaxDisplay.textContent = maxVal.toLocaleString('es-ES');
    }
  };

  // Type selection
  typeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      typeButtons.forEach((b) => {
        b.classList.remove('active', 'border-[#1F1D1A]', 'bg-[#1F1D1A]', 'text-white');
        b.classList.add('border-[#EAE3D7]', 'bg-[#FAF8F5]', 'text-[#57534E]');
      });
      btn.classList.add('active', 'border-[#1F1D1A]', 'bg-[#1F1D1A]', 'text-white');
      btn.classList.remove('border-[#EAE3D7]', 'bg-[#FAF8F5]', 'text-[#57534E]');

      basePricePerMeter = Number(btn.getAttribute('data-price') || '600');
      selectedTypeName = btn.textContent?.trim() || "Reforma";
      calculateEstimate();
    });
  });

  // Slider change
  if (slider && metersDisplay) {
    slider.addEventListener('input', () => {
      surfaceMeters = Number(slider.value);
      metersDisplay.textContent = String(surfaceMeters);
      calculateEstimate();
    });
  }

  // Quality selection
  qualityButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      qualityButtons.forEach((b) => {
        b.classList.remove('active', 'border-[#1F1D1A]', 'bg-[#1F1D1A]', 'text-white');
        b.classList.add('border-[#EAE3D7]', 'bg-[#FAF8F5]', 'text-[#57534E]');
        const sub = b.querySelector('span:first-child');
        if (sub) sub.classList.remove('text-white');
      });
      btn.classList.add('active', 'border-[#1F1D1A]', 'bg-[#1F1D1A]', 'text-white');
      btn.classList.remove('border-[#EAE3D7]', 'bg-[#FAF8F5]', 'text-[#57534E]');

      qualityMultiplier = Number(btn.getAttribute('data-quality') || '1');
      calculateEstimate();
    });
  });

  // Apply to Contact Form
  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      const contactSection = document.getElementById('contacto');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth' });

        const textarea = contactSection.querySelector('textarea');
        if (textarea) {
          const minText = priceMinDisplay?.textContent || '';
          const maxText = priceMaxDisplay?.textContent || '';
          textarea.value = `Hola, he utilizado vuestra calculadora web: me interesa una estimación para ${selectedTypeName} de aproximadamente ${surfaceMeters} m² (rango orientativo: ${minText}€ - ${maxText}€). Me gustaría coordinar una visita técnica gratuita.`;
          textarea.focus();
        }
      }
    });
  }

  // Initial calculation
  calculateEstimate();
</script>
