---
const services = [
  {
    title: "Reformas Integrales",
    desc: "Transformación completa de pisos, viviendas y locales. Gestión integral llave en mano: desde la distribución inicial hasta el último remate.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>`
  },
  {
    title: "Cocinas a Medida",
    desc: "Diseños funcionales con mobiliario de alta durabilidad, encimeras de piedra natural o cuarzo, iluminación integrada y montaje de electrodomésticos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>`
  },
  {
    title: "Baños y Espacios de Agua",
    desc: "Sustitución de bañera por plato de ducha antideslizante a ras de suelo, mamparas de perfil fino, alicatados rectificados y grifería termostática.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>`
  },
  {
    title: "Albañilería y Pladur",
    desc: "Tabiquería seca, foseados para luz indirecta, falsos techos acústicos y térmicos, y nivelación impecable de paramentos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`
  },
  {
    title: "Pintura y Alisado",
    desc: "Eliminación profesional de gotelé, lijado aspirado sin polvo, alisado de paredes con masilla fina y aplicación de pinturas ecológicas lavables.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>`
  },
  {
    title: "Fontanería y Climatización",
    desc: "Instalación completa de redes de agua multicapa, aerotermia, calderas de condensación, radiadores y preinstalación de aire acondicionado.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>`
  },
  {
    title: "Electricidad e Iluminación",
    desc: "Renovación integral del cuadro eléctrico con certificación oficial, cableado libre de halógenos y diseño lumínico arquitectónico con tiras LED.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>`
  },
  {
    title: "Suelos y Pavimentos",
    desc: "Suministro y colocación de tarima flotante AC5, gres porcelánico rectificado de gran formato, microcemento continuo y rodapiés integrados.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>`
  }
];
---

<section id="servicios" class="py-24 bg-[#FAF8F5] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Especialidades</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-4">
        Servicios completos para tu hogar
      </h2>
      <p class="text-[#57534E] text-base leading-relaxed">
        Gestionamos todos los oficios de la construcción con personal cualificado y un único coordinador técnico para que no tengas que preocuparte por nada.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((item) => (
        <div class="bg-white p-7 rounded-2xl border border-[#EAE3D7] shadow-xs hover:border-[#B58C42] hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-11 h-11 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] flex items-center justify-center text-[#B58C42] mb-5 group-hover:bg-[#F4EFE8] group-hover:border-[#B58C42]/40 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </div>
            <h3 class="text-base font-semibold text-[#1F1D1A] mb-2 group-hover:text-[#9C7334] transition-colors">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#57534E] leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[#F4EFE8] flex items-center justify-between text-xs font-medium text-[#78716C] group-hover:text-[#9C7334] transition-colors">
            <span>Consultar disponibilidad</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
