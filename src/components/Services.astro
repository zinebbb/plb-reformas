  {
    title: "Pintura y Acabados Finos",
    tag: "Sin Polvo",
    desc: "Eliminación de gotelé con lijado aspirado profesional, alisado perfecto de paredes y techos, y pintura plástica lavable de alta durabilidad.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>`
  }
];
---

<section id="servicios" class="py-24 bg-[#f8fafc] text-[#111317] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Section Title (Alfa Style: Bold Uppercase with Gold Subtitle) -->
    <div class="fade-up text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest uppercase text-gold-600 block mb-2">
        QUÉ HACEMOS
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[#111317] mb-4">
        Nuestros Servicios en la Comunidad Valenciana
      </h2>
      <div class="w-16 h-1 bg-gold-500 mx-auto mb-5"></div>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
        Abarcamos todos los oficios de la construcción y reforma con personal propio cualificado, garantizando acabados de alta gama y sin retrasos.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((item, idx) => (
        <div 
          class={`fade-up delay-${(idx % 4) * 100} bg-white p-7 rounded-sm border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-gold-500 transition-all duration-300 flex flex-col justify-between group transform hover:-translate-y-1`}
        >
          <div>
            <!-- Icon -->
            <div class="w-12 h-12 rounded-sm bg-black/5 text-gold-600 flex items-center justify-center mb-5 group-hover:bg-gold-500 group-hover:text-black transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </div>

            <!-- Tag -->
            <span class="text-[10px] font-bold uppercase tracking-wider text-gold-600 block mb-1">
              {item.tag}
            </span>

            <!-- Title -->
            <h3 class="text-lg font-bold text-[#111317] uppercase tracking-wide mb-3 group-hover:text-gold-600 transition-colors">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-gold-600">
            <span>Saber más</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
