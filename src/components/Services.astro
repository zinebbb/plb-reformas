---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
const contactUrl = lang === 'es' ? '/#contacto' : '/en/#contacto';
---

<section 
  id="servicios" 
  class="services-section bg-[#F7F5F0] text-[#1a1a1a] relative"
  aria-label={t.services.title}
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="flex flex-col lg:flex-row items-start justify-between gap-12 lg:gap-16 xl:gap-24">
      
      <!-- Columna Izquierda (≈ 34%): Bloque de texto en flujo normal + vídeo sticky top: 110px en escritorio -->
      <aside class="services-aside w-full lg:w-[34%] shrink-0 lg:self-stretch">
        
        <!-- Bloque de texto (flujo normal, se desplaza con el scroll) -->
        <div class="services-text-block">
          <!-- Etiqueta pequeña en bronce -->
          <span 
            class="services-eyebrow text-[12px] uppercase tracking-[0.2em] font-normal text-[#B08D6A] block mb-3 sm:mb-4 select-none"
            style="letter-spacing: 0.2em;"
          >
            {t.services.eyebrow}
          </span>
          
          <!-- Titular en Fraunces 200 sin mayúsculas forzadas -->
          <h2 
            class="services-title text-[clamp(2.2rem,3.8vw,3.6rem)] leading-[1.1] font-light text-[#1a1a1a] mb-6 sm:mb-8"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal; text-wrap: balance;"
          >
            {t.services.title}
          </h2>

          <!-- Frase de apoyo en gris cálido (máx. 40ch) -->
          <p 
            class="services-support text-base sm:text-[1.05rem] text-[#55534e] font-light leading-relaxed max-w-[40ch] mb-8 sm:mb-10"
            style="font-family: 'Outfit', system-ui, sans-serif; font-weight: 300; line-height: 1.6;"
          >
            {t.services.subtitle}
          </p>

          <!-- Único enlace de texto hacia contacto con subrayado fino en bronce -->
          <div>
            <a 
              href={contactUrl}
              class="services-cta inline-flex items-center gap-2 text-xs sm:text-sm uppercase tracking-[0.15em] font-medium text-[#1a1a1a] hover:text-[#B08D6A] pb-1 border-b border-[#B08D6A] transition-colors duration-250 select-none"
              style="letter-spacing: 0.15em;"
            >
              <span>{t.services.cta}</span>
            </a>
          </div>
        </div>

        <!-- Vídeo continuo vertical 4/5: separado 56px del texto, sticky top: 110px en escritorio -->
        <div class="services-aside-media mt-10 mb-10 lg:my-0 lg:mt-14 w-full">
          <div class="services-aside-video-frame relative w-full overflow-hidden rounded-none shadow-none select-none">
            <video 
              id="services-video"
              autoplay 
              muted 
              loop 
              playsinline 
              preload="auto"
              disablePictureInPicture
              controlsList="nodownload nofullscreen noremoteplayback"
              poster="/video/servicios-reforma-poster.webp"
              class="services-aside-video w-full h-full object-cover rounded-none pointer-events-none"
              aria-hidden="true"
            >
              <source src="/video/servicios-reforma.webm" type="video/webm" />
              <source src="/video/servicios-reforma.mp4" type="video/mp4" />
            </video>

            <!-- Poster estático para prefers-reduced-motion -->
            <img 
              src="/video/servicios-reforma-poster.webp" 
              alt="" 
              class="services-aside-poster-static w-full h-full object-cover pointer-events-none" 
              aria-hidden="true" 
            />
          </div>
        </div>

      </aside>

      <!-- Columna Derecha (≈ 58%): Lista interactiva de los 8 servicios -->
      <div class="services-list w-full lg:w-[58%] border-t border-black/12">
        {t.services.items.map((item, idx) => (
          <a 
            href={contactUrl}
            class="service-row group relative block border-b border-black/12 text-left select-none"
            style={`--row-delay: ${idx * 80}ms;`}
            data-index={idx}
            aria-label={`${item.num} ${item.title}: ${item.desc}`}
          >
            <div class="service-row-content flex items-center justify-between gap-4 sm:gap-6 py-6 sm:py-7 lg:py-8">
              
              <div class="flex items-baseline gap-5 sm:gap-7 flex-1 min-w-0">
                <!-- Número pequeño "01" a "08" en bronce -->
                <span 
                  class="service-num text-[12px] uppercase tracking-[0.15em] font-normal text-[#B08D6A] shrink-0 pt-0.5 select-none"
                  style="letter-spacing: 0.15em;"
                >
                  {item.num}
                </span>

                <!-- Bloque de Texto: Título + Frase condensada (máx 90 caracteres) + SEO oculto -->
                <div class="flex-1 min-w-0">
                  <h3 
                    class="service-title text-[clamp(1.5rem,2.4vw,2.2rem)] leading-[1.15] font-light text-[#1a1a1a] mb-1.5"
                    style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal; text-wrap: balance;"
                  >
                    {item.title}
                  </h3>
                  
                  <p 
                    class="service-desc text-xs sm:text-sm text-[#55534e] font-light leading-relaxed"
                    style="font-family: 'Outfit', system-ui, sans-serif; font-weight: 300;"
                  >
                    {item.desc}
                  </p>

                  <!-- Texto descriptivo completo conservado para rastreadores de Google y lectores de pantalla -->
                  <span class="sr-only">{item.seoDesc}</span>
                </div>
              </div>

              <!-- Flecha fina "→" -->
              <div class="service-arrow-box shrink-0 pl-2">
                <span 
                  class="service-arrow inline-block text-xl sm:text-2xl font-light text-[#B08D6A] select-none"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>

            </div>

            <!-- Línea inferior activa en bronce que se dibuja de izquierda a derecha -->
            <span class="service-line-active absolute inset-x-0 bottom-0 h-[1px] bg-[#B08D6A] pointer-events-none" aria-hidden="true"></span>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* Espaciado generoso de 140px arriba y abajo en escritorio, 90px en móvil */
  .services-section {
    padding-top: 90px;
    padding-bottom: 90px;
    overflow: clip;
  }
  @media (min-width: 1024px) {
    .services-section {
      padding-top: 140px;
      padding-bottom: 140px;
    }
  }

  /* Columna izquierda en escritorio: flujo normal y estirada al 100% para permitir que el vídeo se desplace sticky */
  @media (min-width: 1024px) {
    .services-aside {
      align-self: stretch;
    }

    /* Vídeo con position: sticky; top: 110px y 56px de separación bajo el texto */
    .services-aside-media {
      position: sticky;
      top: 110px;
      margin-top: 56px;
      margin-bottom: 0;
      width: 100%;
    }

    /* Marco en escritorio: vertical 4/5, ancho 88% de la columna, alineado a la izquierda */
    /* Altura máxima calc(100vh - 170px); si la ventana es baja, max-width reduce el ancho manteniendo 4/5 */
    .services-aside-video-frame {
      width: 88%;
      max-width: calc((100vh - 170px) * 4 / 5);
      max-height: calc(100vh - 170px);
      aspect-ratio: 4 / 5;
      margin-left: 0;
      margin-right: auto;
    }
  }

  /* Marco del vídeo: revelación con clip-path vertical en 900ms */
  .services-aside-video-frame {
    position: relative;
    overflow: hidden;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: clip-path;
    border-radius: 0;
    box-shadow: none;
    background-color: transparent;
  }

  .services-section.is-visible .services-aside-video-frame {
    clip-path: inset(0 0 0 0);
  }

  /* Móvil: sin sticky, flujo natural con 40px de margen arriba y abajo, ancho completo 4/5 y altura máxima 70vh */
  @media (max-width: 1023px) {
    .services-aside-media {
      position: static;
      margin-top: 40px;
      margin-bottom: 40px;
      width: 100%;
    }

    .services-aside-video-frame {
      width: 100%;
      aspect-ratio: 4 / 5;
      max-height: 70vh;
      margin-left: 0;
      margin-right: 0;
    }
  }

  /* Vídeo continuo tipo GIF con filtro de luminosidad 1.1 y contraste 1.02, y zoom suave de scale(1.08) a scale(1) */
  .services-aside-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    filter: brightness(1.1) contrast(1.02);
    display: block;
    border-radius: 0;
    pointer-events: none;
    transform: scale(1.08);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .services-section.is-visible .services-aside-video {
    transform: scale(1);
  }

  /* Poster estático para prefers-reduced-motion */
  .services-aside-poster-static {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    filter: brightness(1.1) contrast(1.02);
    display: none;
    pointer-events: none;
  }

  /* Entradas al hacer scroll escalonadas: fade-in + translateY(18px) en 650ms */
  .service-row {
    position: relative;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
    text-decoration: none;
    outline: none;
  }

  .services-section.is-visible .service-row {
    opacity: 1;
    transform: translateY(0);
    transition-delay: var(--row-delay, 0ms);
  }

  /* Contenedor interno del contenido que se desplaza 12px a la derecha en hover */
  .service-row-content {
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Título de servicio */
  .service-title {
    transition: color 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Flecha: en escritorio oculta por defecto, se desliza al hover */
  .service-arrow {
    opacity: 0;
    transform: translateX(-10px);
    transition: opacity 350ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Línea inferior que se dibuja de izquierda a derecha en bronce */
  .service-line-active {
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Efecto Hover solo en pantallas con ratón (escritorio) */
  @media (hover: hover) and (min-width: 1024px) {
    /* Dim de las demás filas a 0.55 cuando una fila está en hover */
    .services-list:hover .service-row {
      opacity: 0.55;
      transition: opacity 350ms cubic-bezier(0.22, 1, 0.36, 1),
                  transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: 0ms !important;
    }

    .services-list:hover .service-row:hover {
      opacity: 1;
    }

    .service-row:hover .service-row-content {
      transform: translateX(12px);
    }

    .service-row:hover .service-title {
      color: #B08D6A;
    }

    .service-row:hover .service-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    .service-row:hover .service-line-active {
      transform: scaleX(1);
    }
  }

  /* Enfoque accesible por teclado */
  .service-row:focus-visible {
    opacity: 1 !important;
  }
  .service-row:focus-visible .service-title {
    color: #B08D6A;
    text-decoration: underline;
    text-decoration-color: #B08D6A;
    text-underline-offset: 4px;
  }
  .service-row:focus-visible .service-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .service-row:focus-visible .service-line-active {
    transform: scaleX(1);
  }

  /* Móvil: sin hover, fila táctil con flecha siempre visible y padding vertical de 22px */
  @media (max-width: 1023px) {
    .service-row-content {
      padding-top: 22px;
      padding-bottom: 22px;
    }
    .service-arrow {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Reducción de movimiento accesible */
  @media (prefers-reduced-motion: reduce) {
    .services-aside-video-frame {
      clip-path: none !important;
      transition: none !important;
    }
    .services-aside-video {
      display: none !important;
    }
    .services-aside-poster-static {
      display: block !important;
      transform: none !important;
      transition: none !important;
    }
    .service-row {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .service-row-content {
      transform: none !important;
      transition: none !important;
    }
    .service-title {
      transition: none !important;
    }
    .service-arrow {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .service-line-active {
      transition: none !important;
    }
    .services-list:hover .service-row {
      opacity: 1 !important;
    }
  }
</style>

<script>
  // Velocidad de reproducción ajustable del vídeo decorativo (1.15 = 15% más rápido)
  const VIDEO_SPEED = 1.15;

  function initServices() {
    const section = document.getElementById('servicios');
    const video = document.getElementById('services-video') as HTMLVideoElement | null;
    if (!section) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video) {
      const applySpeed = () => {
        try {
          video.playbackRate = VIDEO_SPEED;
        } catch (_) {}
      };

      // Aplicar velocidad al cargar metadatos y en cada evento play
      video.addEventListener('loadedmetadata', applySpeed);
      video.addEventListener('play', applySpeed);
      applySpeed();

      const safePlay = () => {
        if (!prefersReducedMotion && video.paused) {
          applySpeed();
          video.play().catch(() => {});
        }
      };

      const safePause = () => {
        if (!video.paused) {
          video.pause();
        }
      };

      // Pausar cuando la sección no esté visible y reanudar al volver
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              safePlay();
            } else {
              safePause();
            }
          });
        }, {
          threshold: 0.08,
          rootMargin: '0px 0px -40px 0px'
        });
        observer.observe(section);
      } else {
        section.classList.add('is-visible');
        safePlay();
      }

      // Reanudar cuando la pestaña vuelva a estar visible si la sección está en pantalla
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && section.classList.contains('is-visible')) {
          safePlay();
        } else if (document.hidden) {
          safePause();
        }
      });

      // Intento inicial forzado con catch silencioso
      safePlay();
    } else {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -40px 0px'
        });
        observer.observe(section);
      } else {
        section.classList.add('is-visible');
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServices);
  } else {
    initServices();
  }
  document.addEventListener('astro:page-load', initServices);
</script>
