---
const services = [
  {
    title: "Reformas Integrales",
    desc: "Renovación completa de viviendas, pisos y locales comerciales. Coordinamos todos los gremios para una entrega puntual sin preocupaciones.",
    icon: "🏠"
  },
  {
    title: "Cocinas de Diseño",
    desc: "Distribución optimizada, encimeras de alta resistencia, mobiliario a medida, fontanería y montaje de electrodomésticos.",
    icon: "🍳"
  },
  {
    title: "Baños Modernos",
    desc: "Transformación de baños antiguos, sustitución de bañeras por platos de ducha antideslizantes, mamparas y sanitarios suspendidos.",
    icon: "🚿"
  },
  {
    title: "Albañilería y Pladur",
    desc: "Tabiquería seca de pladur, techos continuos, trasdosados acústicos y térmicos, y reformas estructurales con máxima seguridad.",
    icon: "🧱"
  },
  {
    title: "Pintura y Alisado",
    desc: "Eliminación de gotelé, alisado perfecto de paredes y techos, aplicación de pinturas plásticas lavables y acabados decorativos.",
    icon: "🎨"
  },
  {
    title: "Fontanería y Saneamiento",
    desc: "Instalaciones de tuberías multicapa y cobre, termos eléctricos, calderas, radiadores y reparación de filtraciones o fugas.",
    icon: "🔧"
  },
  {
    title: "Electricidad e Iluminación",
    desc: "Nuevas instalaciones conforme a normativa, cuadros eléctricos, mecanismos modernos y proyectos de iluminación LED de bajo consumo.",
    icon: "⚡"
  },
  {
    title: "Suelos y Pavimentos",
    desc: "Colocación experta de gres porcelánico, tarima flotante de alta resistencia, suelos vinílicos y rodapiés lacados.",
    icon: "🪵"
  }
];
---

<section id="servicios" class="py-20 bg-[#0c0f14] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-gold-400 font-semibold tracking-wider uppercase text-sm">Nuestros Servicios</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-2 mb-4">
        Soluciones completas para cada rincón de tu hogar
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        En PLB Reformas abarcamos todos los oficios y servicios de reforma. Tú no tienes que preocuparte por buscar diferentes profesionales.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((service) => (
        <div class="bg-[#141a24] p-6 rounded-2xl border border-slate-800/80 hover:border-gold-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gold-500/5 group flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/20 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              {service.icon}
            </div>
            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-gold-400 transition-colors">
              {service.title}
            </h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              {service.desc}
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-800/60 flex items-center text-xs font-semibold text-gold-400 gap-1 group-hover:gap-2 transition-all">
            <span>Saber más</span>
            <span>→</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
