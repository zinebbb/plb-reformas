---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section 
  id="nosotros" 
  class="about-section bg-[#F7F5F0] text-[#1a1a1a] relative overflow-hidden"
  aria-label={t.about.eyebrow}
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-12 lg:gap-16 xl:gap-24">
      
      <!-- Columna Izquierda (≈ 42%): Vídeo a sangre en relación 4/5 con revelación vertical -->
      <div class="about-media-col w-full lg:w-[42%] shrink-0">
        <div class="about-media-frame relative aspect-[4/5] w-full overflow-hidden rounded-none select-none">
          <!-- Vídeo continuo sin controles tipo GIF -->
          <video 
            id="about-video"
            autoplay 
            muted 
            loop 
            playsinline 
            preload="metadata"
            disablePictureInPicture
            controlsList="nodownload nofullscreen noremoteplayback"
            poster="/video/about-reforma-poster.webp"
            class="about-video w-full h-full object-cover rounded-none pointer-events-none"
            aria-hidden="true"
          >
            <source src="/video/about-reforma.webm" type="video/webm" />
            <source src="/video/about-reforma.mp4" type="video/mp4" />
          </video>

          <!-- Poster estático para prefers-reduced-motion -->
          <img 
            src="/video/about-reforma-poster.webp" 
            alt="" 
            class="about-poster-static w-full h-full object-cover pointer-events-none" 
            aria-hidden="true" 
          />
        </div>
      </div>

      <!-- Columna Derecha (≈ 50%): Contenido editorial equilibrado -->
      <div class="about-content-col w-full lg:w-[50%] flex flex-col justify-center">
        
        <!-- Bloque a + b: Etiqueta y Titular -->
        <div class="about-reveal about-reveal--1">
          <span 
            class="about-eyebrow text-[12px] uppercase tracking-[0.2em] font-normal text-[#B08D6A] block mb-3 sm:mb-4"
            style="letter-spacing: 0.2em;"
          >
            {t.about.eyebrow}
          </span>
          <h2 
            class="about-title text-[clamp(2.1rem,3.8vw,3.5rem)] leading-[1.12] font-light text-[#1a1a1a] mb-6 sm:mb-8"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal; text-wrap: balance;"
          >
            {t.about.title}
          </h2>
        </div>

        <!-- Bloque c: Un solo párrafo, máx 4 líneas, peso 300-400, color gris cálido, max-width 52ch -->
        <div class="about-reveal about-reveal--2">
          <p 
            class="about-lead text-base sm:text-[1.08rem] text-[#55534e] font-light leading-relaxed max-w-[52ch] mb-8 sm:mb-10"
            style="font-family: 'Outfit', system-ui, sans-serif; font-weight: 300; line-height: 1.65;"
          >
            {t.about.desc}
          </p>
        </div>

        <!-- Bloque d: Cita destacada sin recuadro ni borde, Fraunces 200 normal, con comilla de apertura bronce -->
        <div class="about-reveal about-reveal--3">
          <span 
            class="about-quote-mark block text-[#B08D6A] text-5xl sm:text-6xl leading-none font-light select-none mb-2 sm:mb-3"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200;"
            aria-hidden="true"
          >
            “
          </span>
          <p 
            class="about-quote-text text-[clamp(1.4rem,2.1vw,1.95rem)] leading-[1.32] text-[#1a1a1a] font-light"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal; text-wrap: balance;"
          >
            {t.about.quote}
          </p>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* Espaciado generoso de 140px arriba y abajo en escritorio, 90px en móvil */
  .about-section {
    padding-top: 90px;
    padding-bottom: 90px;
  }
  @media (min-width: 1024px) {
    .about-section {
      padding-top: 140px;
      padding-bottom: 140px;
    }
  }

  /* Revelación de vídeo con clip-path de abajo hacia arriba en 900ms */
  .about-media-frame {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: clip-path;
  }
  .about-section.is-visible .about-media-frame {
    clip-path: inset(0 0 0 0);
  }

  /* Vídeo continuo tipo GIF con filtro de luminosidad 1.1 y contraste 1.02, y zoom suave de scale(1.08) a scale(1) */
  .about-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    filter: brightness(1.1) contrast(1.02);
    display: block;
    border-radius: 0;
    pointer-events: none;
    transform: scale(1.08);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .about-section.is-visible .about-video {
    transform: scale(1);
  }

  /* Poster estático para prefers-reduced-motion */
  .about-poster-static {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    filter: brightness(1.1) contrast(1.02);
    display: none;
    pointer-events: none;
  }

  /* Entradas escalonadas al hacer scroll: fade-in + translateY(20px) en 700ms con retraso de 120ms */
  .about-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .about-section.is-visible .about-reveal--1 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0ms;
  }

  .about-section.is-visible .about-reveal--2 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 120ms;
  }

  .about-section.is-visible .about-reveal--3 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 240ms;
  }

  /* Reducción de movimiento accesible */
  @media (prefers-reduced-motion: reduce) {
    .about-media-frame {
      clip-path: none !important;
      transition: none !important;
    }
    .about-video {
      display: none !important;
    }
    .about-poster-static {
      display: block !important;
      transform: none !important;
      transition: none !important;
    }
    .about-reveal {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Velocidad de reproducción ajustable del vídeo decorativo (1.15 = 15% más rápido)
  const VIDEO_SPEED = 1.15;

  function initAbout() {
    const section = document.getElementById('nosotros');
    const video = document.getElementById('about-video') as HTMLVideoElement | null;
    if (!section) return;

    // Respetar preferencia de reducción de movimiento
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video) {
      const applySpeed = () => {
        try {
          video.playbackRate = VIDEO_SPEED;
        } catch (_) {}
      };

      video.addEventListener('loadedmetadata', applySpeed);
      video.addEventListener('play', applySpeed);
      applySpeed();

      const safePlay = () => {
        if (!prefersReducedMotion && video.paused) {
          applySpeed();
          video.play().catch(() => {});
        }
      };

      const safePause = () => {
        if (!video.paused) {
          video.pause();
        }
      };

      // IntersectionObserver para activar animaciones de entrada y pausar/reanudar vídeo
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              safePlay();
            } else {
              safePause();
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px'
        });

        observer.observe(section);
      } else {
        section.classList.add('is-visible');
        safePlay();
      }

      // Reanudar/pausar al cambiar la visibilidad de pestaña
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && section.classList.contains('is-visible')) {
          safePlay();
        } else if (document.hidden) {
          safePause();
        }
      });

      // Intento inicial silencioso
      safePlay();
    } else {
      section.classList.add('is-visible');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAbout);
  } else {
    initAbout();
  }
  document.addEventListener('astro:page-load', initAbout);
</script>
