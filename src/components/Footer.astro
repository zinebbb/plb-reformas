---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const copyrightText = t.footer.copyright.replace('{year}', String(currentYear));
const whatsappUrl = `https://wa.me/34602525866?text=${encodeURIComponent(t.whatsapp.message)}`;
---

<footer class="mt-auto bg-[#EFEBE3] border-t border-black/8 pt-16 pb-12 text-[#1a1a1a]">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- 3-Column Minimalist Layout in Desktop -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 mb-16 items-start">
      
      <!-- Column 1: Brand & Description (Sin cajas ni iconos con borde) -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/images/logo-icon-original.png" 
            alt="PLB Reformas Premium S.L." 
            class="h-9 w-auto object-contain"
          />
          <div class="flex flex-col">
            <span 
              class="text-xs uppercase font-light tracking-[0.22em] text-[#1a1a1a] leading-none"
              style="font-family: 'Montserrat', system-ui, sans-serif; letter-spacing: 0.22em;"
            >
              PLB <span class="text-[#B08D6A] font-medium">REFORMAS</span>
            </span>
            <span 
              class="text-[9px] uppercase tracking-[0.18em] text-[#706e6b] font-light mt-1"
              style="letter-spacing: 0.18em;"
            >
              PREMIUM S.L.
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-[#55534e] leading-relaxed font-normal">
          {t.footer.desc}
        </p>
        <p 
          class="text-xs text-[#B08D6A] font-medium tracking-[0.1em] uppercase pt-1"
          style="letter-spacing: 0.1em;"
        >
          {t.footer.coverageBadge}
        </p>
      </div>

      <!-- Column 2: Services Links (Sin viñetas, hover a bronce) -->
      <div>
        <h4 
          class="text-xs uppercase tracking-[0.2em] text-[#B08D6A] font-normal mb-5"
          style="letter-spacing: 0.2em;"
        >
          {t.footer.servicesTitle}
        </h4>
        <ul class="space-y-3 text-xs sm:text-sm">
          {t.footer.services.map((serviceName) => (
            <li>
              <a href="#servicios" class="text-[#55534e] hover:text-[#B08D6A] transition-colors font-normal">
                {serviceName}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact & Hours (Teléfono, email, horario, visita técnica) -->
      <div>
        <h4 
          class="text-xs uppercase tracking-[0.2em] text-[#B08D6A] font-normal mb-5"
          style="letter-spacing: 0.2em;"
        >
          {t.footer.contactTitle}
        </h4>
        <ul class="space-y-3.5 text-xs sm:text-sm">
          <li>
            <span 
              class="block text-[10px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-0.5"
              style="letter-spacing: 0.15em;"
            >
              {t.footer.callLabel}
            </span>
            <a 
              href="tel:+34602525866" 
              class="text-base text-[#1a1a1a] hover:text-[#B08D6A] transition-colors font-light"
              style="font-family: 'Inter', system-ui, -apple-system, sans-serif; font-weight: 300;"
            >
              +34 602 525 866
            </a>
          </li>
          <li>
            <span 
              class="block text-[10px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-0.5"
              style="letter-spacing: 0.15em;"
            >
              {t.footer.emailLabel}
            </span>
            <a href="mailto:info@plbreformas.es" class="text-xs sm:text-sm text-[#55534e] hover:text-[#B08D6A] transition-colors font-normal">
              info@plbreformas.es
            </a>
          </li>
          <li>
            <span 
              class="block text-[10px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-0.5"
              style="letter-spacing: 0.15em;"
            >
              {t.footer.hoursLabel}
            </span>
            <span class="text-xs text-[#55534e] font-normal">{t.footer.hoursVal}</span>
          </li>
          <li>
            <span 
              class="block text-[10px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-0.5"
              style="letter-spacing: 0.15em;"
            >
              {t.footer.technicalVisitsLabel}
            </span>
            <span class="text-xs text-[#B08D6A] font-medium">{t.footer.technicalVisitsVal}</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-black/8 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#706e6b] gap-4">
      <p class="font-normal">{copyrightText}</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-[#B08D6A] transition-colors font-normal">{t.footer.legal}</a>
        <a href="#" class="hover:text-[#B08D6A] transition-colors font-normal">{t.footer.privacy}</a>
        <a href="#" class="hover:text-[#B08D6A] transition-colors font-normal">{t.footer.cookies}</a>
      </div>
    </div>

  </div>

  <!-- Floating WhatsApp Circular Button (Intacto) -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    aria-label={t.whatsapp.ariaLabel}
    title={t.whatsapp.title}
    class="whatsapp-float fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex items-center justify-center text-white"
  >
    <span class="whatsapp-pulse-ring" aria-hidden="true"></span>
    <svg 
      class="w-7 h-7 text-white fill-current relative z-10" 
      viewBox="0 0 24 24"
      width="28"
      height="28"
      aria-hidden="true"
    >
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>
</footer>

<style>
  .whatsapp-float {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #25D366;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    transition: transform 250ms ease-in-out;
  }

  .whatsapp-float:hover {
    transform: scale(1.08);
  }

  .whatsapp-pulse-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid #25D366;
    background-color: rgba(37, 211, 102, 0.25);
    pointer-events: none;
    z-index: 0;
    animation: whatsappPulseRing 4s cubic-bezier(0.1, 0.8, 0.3, 1) infinite;
  }

  @keyframes whatsappPulseRing {
    0% {
      transform: scale(0.95);
      opacity: 0.85;
    }
    30% {
      transform: scale(1.45);
      opacity: 0;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
</style>