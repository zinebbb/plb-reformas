---
---

<footer class="bg-[#0a0c0f] border-t border-white/10 pt-20 pb-12 text-gray-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Brand & Description -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="p-1.5 bg-white/10 rounded-sm border border-white/20">
            <img 
              src="/images/logo.jpeg" 
              alt="PLB Reformas Premium S.L." 
              class="h-9 w-auto object-contain rounded-xs"
            />
          </div>
          <div>
            <span class="block text-base font-extrabold text-white tracking-widest uppercase">PLB</span>
            <span class="block text-[10px] font-bold text-gold-500 tracking-widest uppercase">Reformas Premium S.L.</span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed font-normal">
          Empresa de reformas integrales, diseño de interiores y construcción en la Comunidad Valenciana. Proyectos llave en mano con contrato cerrado, pago por etapas y garantía por escrito de 2 años.
        </p>
        <div class="text-xs text-gold-500 font-semibold tracking-wider uppercase">
          Proyectos en toda la Comunidad Valenciana
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-5">
          Servicios
        </h4>
        <ul class="space-y-3 text-xs sm:text-sm">
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Reformas Integrales de Pisos</a></li>
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Reformas de Cocinas de Diseño</a></li>
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Reformas de Baños Modernos</a></li>
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Albañilería y Tabiquería Pladur</a></li>
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Suelos y Revestimientos Porcelánicos</a></li>
          <li><a href="#servicios" class="hover:text-gold-500 transition-colors">Electricidad, Climatización y LED</a></li>
        </ul>
      </div>

      <!-- Coverage Areas -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-5">
          Zonas de Cobertura
        </h4>
        <ul class="space-y-2.5 text-xs text-gray-400">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Toda la Comunidad Valenciana</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Reformas integrales residenciales</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Chalets, villas y viviendas unifamiliares</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Locales comerciales y oficinas</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Medición y asesoramiento in situ sin coste</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-500"></span>
            <span>Dirección facultativa y gremios propios</span>
          </li>
        </ul>
      </div>

      <!-- Contact & Hours -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-5">
          Contacto y Asistencia
        </h4>
        <ul class="space-y-3 text-xs sm:text-sm">
          <li>
            <span class="block text-[11px] uppercase tracking-wider text-gray-500">Llámanos</span>
            <a href="tel:+34600000000" class="text-white hover:text-gold-500 font-bold transition-colors">
              +34 600 000 000
            </a>
          </li>
          <li>
            <span class="block text-[11px] uppercase tracking-wider text-gray-500">Email</span>
            <a href="mailto:info@plbreformas.es" class="text-white hover:text-gold-500 transition-colors">
              info@plbreformas.es
            </a>
          </li>
          <li>
            <span class="block text-[11px] uppercase tracking-wider text-gray-500">Horario de Oficina</span>
            <span class="text-gray-300">Lunes a Viernes: 8:00 - 19:00</span>
          </li>
          <li>
            <span class="block text-[11px] uppercase tracking-wider text-gray-500">Visitas Técnicas</span>
            <span class="text-gold-500 font-medium">Medición in situ sin coste</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 gap-4">
      <p>© {new Date().getFullYear()} PLB REFORMAS PREMIUM S.L. Todos los derechos reservados. Comunidad Valenciana.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-gold-500 transition-colors">Aviso Legal</a>
        <a href="#" class="hover:text-gold-500 transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-gold-500 transition-colors">Política de Cookies</a>
      </div>
    </div>

  </div>

  <!-- Floating WhatsApp Pill Button -->
  <a 
    href="https://wa.me/34600000000?text=Hola,%20quisiera%20solicitar%20presupuesto%20para%20una%20reforma%20en%20la%20Comunidad%20Valenciana" 
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="fixed bottom-6 right-6 z-50 flex items-center gap-2.5 bg-black/90 hover:bg-black text-white px-4 py-3 rounded-full shadow-2xl border border-gold-500/50 hover:border-gold-500 transition-all duration-300 group backdrop-blur-md"
  >
    <div class="w-8 h-8 rounded-full bg-[#25D366] flex items-center justify-center text-white shrink-0 group-hover:scale-110 transition-transform">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
      </svg>
    </div>
    <span class="text-xs font-bold pr-1 uppercase tracking-wider text-gold-500 group-hover:text-white transition-colors">¿Hablamos por WhatsApp?</span>
  </a>
</footer>
