---
---

<footer class="bg-[#090b0e] border-t border-slate-800/80 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand column -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/images/logo.jpeg" 
            alt="PLB Reformas Premium S.L." 
            class="h-12 w-auto rounded-lg object-contain bg-white p-1"
          />
          <div>
            <span class="block text-lg font-bold text-white tracking-wider">PLB</span>
            <span class="block text-xs font-semibold text-gold-400 tracking-widest uppercase">Reformas Premium S.L.</span>
          </div>
        </div>
        <p class="text-slate-400 text-sm max-w-md leading-relaxed">
          Tu empresa de confianza para reformas integrales, albañilería, fontanería, electricidad, cocinas, baños y pintura. Acabados profesionales con garantía de calidad y satisfacción.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Navegación</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="#servicios" class="hover:text-gold-400 transition-colors">Servicios Integrales</a></li>
          <li><a href="#proyectos" class="hover:text-gold-400 transition-colors">Vídeos de Obras</a></li>
          <li><a href="#por-que-nosotros" class="hover:text-gold-400 transition-colors">Ventajas & Garantías</a></li>
          <li><a href="#contacto" class="hover:text-gold-400 transition-colors">Presupuesto Online</a></li>
        </ul>
      </div>

      <!-- Legal / Services -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Servicios Principales</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><span>Reformas Integrales</span></li>
          <li><span>Cocinas y Baños</span></li>
          <li><span>Fontanería & Electricidad</span></li>
          <li><span>Albañilería y Pladur</span></li>
          <li><span>Pintura y Suelos</span></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-slate-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {new Date().getFullYear()} PLB REFORMAS PREMIUM S.L. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-slate-400 transition-colors">Aviso Legal</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Cookies</a>
      </div>
    </div>

  </div>

  <!-- Floating WhatsApp Button -->
  <a 
    href="https://wa.me/34600000000?text=Hola,%20quisiera%20pedir%20presupuesto%20para%20una%20reforma" 
    target="_blank" 
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white flex items-center justify-center shadow-2xl shadow-emerald-500/50 transition-all duration-300 hover:scale-110 group"
  >
    <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
    <span class="sr-only">Contactar por WhatsApp</span>
  </a>
</footer>
