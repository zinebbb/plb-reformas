---
const steps = [
  {
    num: "01",
    phase: "FASE 01",
    title: "Visita y Asesoramiento In Situ",
    desc: "Nos desplazamos a tu vivienda o local en Benidorm o cualquier punto de la Marina Baixa. Evaluamos el estado técnico, escuchamos tus ideas y realizamos mediciones precisas sin coste alguno."
  },
  {
    num: "02",
    phase: "FASE 02",
    title: "Presupuesto Cerrado por Contrato",
    desc: "Elaboramos una propuesta técnica desglosada partida por partida con calidades y precios cerrados. Lo estipulado en contrato es lo que pagas, sin sorpresas ni costes ocultos."
  },
  {
    num: "03",
    phase: "FASE 03",
    title: "Ejecución y Pago por Etapas",
    desc: "Un jefe de obra coordina a nuestro equipo de especialistas. No abonas la totalidad por adelantado: los pagos se realizan de forma estructurada según avance certificado de la obra."
  },
  {
    num: "04",
    phase: "FASE 04",
    title: "Entrega Impecable y Garantía Oficial",
    desc: "Revisamos contigo cada acabado y detalle. Realizamos una limpieza exhaustiva post-obra y te hacemos entrega formal de la garantía por escrito de 2 años."
  }
];
---

<section id="proceso" class="py-24 bg-white text-[#111317] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Section Header (Alfa Interiorismo Style) -->
    <div class="fade-up text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest uppercase text-gold-600 block mb-2">
        CÓMO TRABAJAMOS
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[#111317] mb-4">
        Metodología y Fases de Obra
      </h2>
      <div class="w-16 h-1 bg-gold-500 mx-auto mb-5"></div>
      <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal">
        Un proceso estructurado, transparente y riguroso para que disfrutes de la reforma de tu vivienda en la Costa Blanca con total tranquilidad.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, idx) => (
        <div 
          class={`fade-up delay-${(idx + 1) * 100} p-8 bg-[#f8fafc] border border-gray-200 hover:border-gold-500 hover:shadow-lg transition-all duration-300 rounded-sm flex flex-col justify-between group`}
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl font-extrabold text-gold-600 group-hover:scale-105 transition-transform">
                {step.num}
              </span>
              <span class="text-[10px] font-bold tracking-widest uppercase text-gray-400 bg-white px-2.5 py-1 border border-gray-200 rounded-xs">
                {step.phase}
              </span>
            </div>

            <h3 class="text-lg font-bold uppercase tracking-tight text-[#111317] mb-3 group-hover:text-gold-600 transition-colors">
              {step.title}
            </h3>

            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">
              {step.desc}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-gray-200 flex items-center justify-between text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
            <span>Paso {idx + 1} de 4</span>
            <span class="text-gold-600 font-bold">PLB Premium</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
