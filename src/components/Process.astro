---
const steps = [
  {
    number: "01",
    title: "Visita y Asesoramiento Técnico",
    desc: "Acudimos a tu vivienda o local, escuchamos tus ideas, analizamos el espacio y tomamos mediciones completas de forma gratuita y sin compromiso."
  },
  {
    number: "02",
    title: "Presupuesto Detallado y Cerrado",
    desc: "En un plazo máximo de 48 horas recibirás una propuesta clara con cada partida desglosada (materiales, mano de obra e impuestos). Sin sorpresas."
  },
  {
    number: "03",
    title: "Ejecución con Jefe de Obra Dedicado",
    desc: "Un único profesional supervisa los gremios diariamente, garantizando el cumplimiento del calendario de obra y manteniéndote informado."
  },
  {
    number: "04",
    title: "Entrega de Llaves y Garantía Oficial",
    desc: "Realizamos una revisión final contigo, dejamos la vivienda limpia para entrar a vivir y te entregamos la garantía oficial por escrito."
  }
];
---

<section id="proceso" class="py-24 bg-[#F4EFE8] border-y border-[#EAE3D7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="fade-up text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Metodología de Trabajo</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-4">
        Tu reforma en 4 sencillos pasos
      </h2>
      <p class="text-[#57534E] text-base leading-relaxed">
        Un proceso estructurado y transparente para que disfrutes de la transformación de tu vivienda sin estrés ni incertidumbres.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, index) => (
        <div 
          class={`fade-up delay-${(index + 1) * 100} relative bg-white p-8 rounded-2xl border border-[#EAE3D7] shadow-xs flex flex-col justify-between hover:shadow-md hover:border-[#B58C42]/50 transition-all duration-300 transform hover:-translate-y-1`}
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-2xl font-serif font-bold text-[#9C7334]">{step.number}</span>
              <span class="w-8 h-8 rounded-full bg-[#FAF8F5] border border-[#EAE3D7] flex items-center justify-center text-xs font-semibold text-[#78716C]">
                {index + 1}/4
              </span>
            </div>
            <h3 class="text-lg font-semibold text-[#1F1D1A] mb-3">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#57534E] leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
