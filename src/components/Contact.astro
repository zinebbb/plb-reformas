---
---

<section id="contacto" class="py-24 bg-white text-[#111317] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Direct Info -->
      <div class="fade-up lg:col-span-5">
        <span class="text-xs font-bold tracking-widest uppercase text-gold-600 block mb-2">
          CONTACTO DIRECTO
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[#111317] mb-4">
          Obtener <span class="font-editorial text-gold-600 lowercase tracking-normal text-4xl sm:text-5xl font-normal italic">presupuesto</span>
        </h2>
        <div class="w-16 h-1 bg-gold-500 mb-6"></div>

        <!-- Alfa Interiorismo High-trust Callout -->
        <div class="p-4 bg-gold-500/10 border-l-4 border-gold-500 rounded-xs mb-6">
          <p class="text-xs sm:text-sm font-semibold text-[#111317]">
            Pide la visita técnica gratuita de medición el mismo día que lo solicitas.
          </p>
        </div>
        
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-8">
          Todos nuestros proyectos comienzan con una reunión. Déjanos tus datos o contáctanos directamente para recibir una consulta detallada sobre tu proyecto, así como un desglose de costes y plazos de obra garantizados.
        </p>

        <!-- Direct Channels -->
        <div class="space-y-6 pt-6 border-t border-gray-200">
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-black text-gold-500 rounded-sm flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-0.5">Atención Telefónica</span>
              <a href="tel:+34600000000" class="text-xl sm:text-2xl font-extrabold text-[#111317] hover:text-gold-600 transition-colors">
                +34 600 000 000
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-[#25D366] text-white rounded-sm flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-0.5">WhatsApp Directo</span>
              <a 
                href="https://wa.me/34600000000?text=Hola,%20quisiera%20solicitar%20presupuesto%20para%20una%20reforma%20en%20la%20Comunidad%20Valenciana" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-base font-bold text-[#111317] hover:text-[#25D366] transition-colors inline-flex items-center gap-1.5"
              >
                <span>Chatear por WhatsApp</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-black text-gold-500 rounded-sm flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-0.5">Zona de Operación</span>
              <span class="text-sm font-semibold text-[#111317]">
                Toda la Comunidad Valenciana y municipios limítrofes
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Contact Form Box -->
      <div class="fade-up delay-100 lg:col-span-7 bg-[#f8fafc] p-8 sm:p-12 border border-gray-200 rounded-sm shadow-md">
        <h3 class="text-2xl font-extrabold uppercase tracking-tight text-[#111317] mb-2">
          Envíanos tu consulta
        </h3>
        <p class="text-xs text-gray-500 mb-8 font-medium">
          Te contactaremos en menos de 24 horas para coordinar la visita técnica gratuita.
        </p>

        <form id="contact-form" class="space-y-5">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Nombre completo *</label>
              <input 
                type="text" 
                name="name" 
                required 
                placeholder="Tu nombre" 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Teléfono de contacto *</label>
              <input 
                type="tel" 
                name="phone" 
                required 
                placeholder="600 000 000" 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Tipo de Proyecto</label>
              <select 
                name="project" 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              >
                <option value="integral">Reforma Integral de Piso</option>
                <option value="chalet">Reforma de Chalet / Villa</option>
                <option value="cocina">Cocina a Medida</option>
                <option value="bano">Baño / Plato de ducha</option>
                <option value="local">Local Comercial / Negocio</option>
                <option value="otro">Varios Oficios / Otros</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Municipio o Zona</label>
              <input 
                type="text" 
                name="location" 
                placeholder="Ej. Localidad en la Comunidad Valenciana..." 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Cuéntanos sobre tu reforma</label>
            <textarea 
              name="message" 
              rows="4" 
              placeholder="Indícanos los metros aproximados, qué cambios te gustaría realizar o cuándo te gustaría empezar..." 
              class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
            ></textarea>
          </div>

          <div id="contact-feedback" class="hidden p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold uppercase tracking-wider">
            ✓ ¡Solicitud recibida con éxito! Te contactaremos a la mayor brevedad.
          </div>

          <button 
            type="submit" 
            class="w-full py-4 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:from-gold-500 hover:to-gold-400 text-black font-extrabold text-sm uppercase tracking-widest rounded-sm shadow-lg transition-all cursor-pointer"
          >
            Obtener Presupuesto Ahora!
          </button>

          <p class="text-[11px] text-center text-gray-500">
            Tus datos son 100% confidenciales. Presupuesto sin compromiso.
          </p>

        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('contact-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Solicitud Enviada Correctamente ✓";
        submitBtn.classList.remove('from-gold-400', 'via-gold-500', 'to-gold-600');
        submitBtn.classList.add('bg-emerald-600', 'text-white', 'cursor-not-allowed');
      }
    });
  }
</script>
