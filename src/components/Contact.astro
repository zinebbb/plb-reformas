---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="contacto" class="py-28 lg:py-36 bg-[#F7F5F0] text-[#1a1a1a] relative">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-20 items-start">
      
      <!-- Left Column: Direct Info -->
      <div class="fade-up lg:col-span-5 space-y-8">
        <div>
          <span 
            class="text-xs uppercase font-normal tracking-[0.2em] text-[#B08D6A] block mb-3"
            style="letter-spacing: 0.2em;"
          >
            {t.contact.eyebrow}
          </span>
          <h2 
            class="text-[clamp(2.2rem,4vw,3.4rem)] leading-[1.12] font-light text-[#1a1a1a] tracking-tight mb-5"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal;"
          >
            {t.contact.title}
          </h2>
          <p 
            class="text-lg sm:text-xl text-[#1a1a1a] leading-snug font-light mb-4"
            style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal;"
          >
            {t.contact.callout}
          </p>
          <p class="text-sm sm:text-base text-[#66645f] leading-relaxed font-normal">
            {t.contact.desc}
          </p>
        </div>

        <!-- Teléfono de contacto directo -->
        <div class="pt-2">
          <span 
            class="block text-[11px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-1"
            style="letter-spacing: 0.15em;"
          >
            {t.contact.phoneLabel}
          </span>
          <a 
            href="tel:+34602525866" 
            class="inline-block text-2xl sm:text-[1.75rem] text-[#1a1a1a] hover:text-[#B08D6A] transition-colors leading-tight font-light"
            style="font-family: 'Inter', system-ui, -apple-system, sans-serif; font-weight: 300; letter-spacing: 0.02em;"
            aria-label="Llamar a PLB Reformas: +34 602 525 866"
          >
            +34 602 525 866
          </a>
        </div>

        <!-- Canales y detalles de atención (Email, Zona, Horarios, Visita) -->
        <div class="pt-6 border-t border-black/8 space-y-5">
          <div>
            <span 
              class="block text-[11px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-1"
              style="letter-spacing: 0.15em;"
            >
              {t.contact.emailLabel}
            </span>
            <a 
              href="mailto:info@plbreformas.es" 
              class="text-sm sm:text-base text-[#1a1a1a] hover:text-[#B08D6A] transition-colors font-normal"
            >
              info@plbreformas.es
            </a>
          </div>

          <div>
            <span 
              class="block text-[11px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-1"
              style="letter-spacing: 0.15em;"
            >
              {t.contact.areaLabel}
            </span>
            <span class="text-sm text-[#55534e] font-normal">
              {t.contact.areaVal}
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
            <div>
              <span 
                class="block text-[11px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-1"
                style="letter-spacing: 0.15em;"
              >
                {t.contact.hoursLabel}
              </span>
              <span class="text-xs text-[#66645f] font-normal">
                {t.contact.hoursVal}
              </span>
            </div>
            <div>
              <span 
                class="block text-[11px] uppercase tracking-[0.15em] text-[#B08D6A] font-normal mb-1"
                style="letter-spacing: 0.15em;"
              >
                {t.contact.technicalVisitsLabel}
              </span>
              <span class="text-xs text-[#B08D6A] font-medium">
                {t.contact.technicalVisitsVal}
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Contact Form (Directamente sobre el fondo, sin caja ni bordes) -->
      <div class="fade-up delay-100 lg:col-span-7">
        <h3 
          class="text-[clamp(1.75rem,2.8vw,2.3rem)] leading-tight font-light text-[#1a1a1a] mb-2"
          style="font-family: var(--font-titulos, 'Fraunces', serif); font-weight: 200; font-style: normal;"
        >
          {t.contact.formTitle}
        </h3>
        <p class="text-xs sm:text-sm text-[#66645f] mb-8 font-normal">
          {t.contact.formSubtitle}
        </p>

        <form id="contact-form" class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-[11px] uppercase tracking-[0.12em] font-medium text-[#706e6b] mb-1">
                {t.contact.nameLabel}
              </label>
              <input 
                type="text" 
                name="name" 
                required 
                placeholder={t.contact.namePlaceholder} 
                class="contact-field"
              />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-[0.12em] font-medium text-[#706e6b] mb-1">
                {t.contact.phoneInputLabel}
              </label>
              <input 
                type="tel" 
                name="phone" 
                required 
                placeholder={t.contact.phonePlaceholder} 
                class="contact-field"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-[11px] uppercase tracking-[0.12em] font-medium text-[#706e6b] mb-1">
                {t.contact.projectLabel}
              </label>
              <select 
                name="project" 
                class="contact-field"
              >
                <option value="integral">{t.contact.projectOptions.integral}</option>
                <option value="chalet">{t.contact.projectOptions.chalet}</option>
                <option value="cocina">{t.contact.projectOptions.cocina}</option>
                <option value="bano">{t.contact.projectOptions.bano}</option>
                <option value="local">{t.contact.projectOptions.local}</option>
                <option value="otro">{t.contact.projectOptions.otro}</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-[0.12em] font-medium text-[#706e6b] mb-1">
                {t.contact.locationLabel}
              </label>
              <input 
                type="text" 
                name="location" 
                placeholder={t.contact.locationPlaceholder} 
                class="contact-field"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] uppercase tracking-[0.12em] font-medium text-[#706e6b] mb-1">
              {t.contact.messageLabel}
            </label>
            <textarea 
              name="message" 
              rows="3" 
              placeholder={t.contact.messagePlaceholder} 
              class="contact-field resize-y"
            ></textarea>
          </div>

          <div id="contact-feedback" class="hidden p-4 bg-[#EFEBE3] border-l-2 border-[#B08D6A] text-[#1a1a1a] text-xs font-normal">
            {t.contact.feedback}
          </div>

          <div class="pt-2">
            <button 
              type="submit" 
              data-success-text={t.contact.submitSuccess}
              class="w-full sm:w-auto px-10 py-4 bg-[#1a1a1a] hover:bg-[#B08D6A] text-white font-normal text-xs uppercase tracking-[0.15em] rounded-[1px] transition-colors duration-250 cursor-pointer shadow-none"
              style="letter-spacing: 0.15em;"
            >
              {t.contact.submitBtn}
            </button>
            <p class="text-[11px] text-[#8a8782] font-normal mt-3">
              {t.contact.privacyNote}
            </p>
          </div>

        </form>
      </div>

    </div>

  </div>
</section>

<style>
  .contact-field {
    width: 100%;
    background-color: transparent;
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    padding: 12px 0;
    font-size: 0.95rem;
    color: #1a1a1a;
    border-radius: 0;
    outline: none;
    transition: border-color 250ms ease-in-out;
  }

  .contact-field::placeholder {
    color: #9c9993;
    opacity: 0.8;
  }

  .contact-field:focus {
    border-bottom-color: #B08D6A;
  }

  select.contact-field {
    cursor: pointer;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23706e6b' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0 center;
    background-size: 1rem;
    padding-right: 1.5rem;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('contact-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        const successText = submitBtn.getAttribute('data-success-text') || "Solicitud Enviada Correctamente";
        submitBtn.textContent = successText;
        submitBtn.classList.remove('bg-[#1a1a1a]', 'hover:bg-[#B08D6A]');
        submitBtn.classList.add('bg-[#55534e]', 'text-white', 'cursor-not-allowed');
      }
    });
  }
</script>