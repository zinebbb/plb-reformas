---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
const whatsappUrl = `https://wa.me/34602525866?text=${encodeURIComponent(t.whatsapp.message)}`;
---

<section id="contacto" class="py-24 bg-white text-[#111317] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Left Column: Direct Info -->
      <div class="fade-up lg:col-span-5">
        <span class="text-xs font-bold tracking-widest uppercase text-gold-600 block mb-2">
          {t.contact.eyebrow}
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[#111317] mb-4">
          {t.contact.title}
        </h2>
        <div class="w-16 h-1 bg-gold-500 mb-6"></div>

        <!-- High-trust Callout -->
        <div class="p-4 bg-gold-500/10 border-l-4 border-gold-500 rounded-xs mb-6">
          <p class="text-xs sm:text-sm font-semibold text-[#111317]">
            {t.contact.callout}
          </p>
        </div>
        
        <p class="text-sm sm:text-base text-gray-600 leading-relaxed mb-6">
          {t.contact.desc}
        </p>

        <!-- Apartado Visual Exclusivo para el Teléfono (Minimalista, tipografía Inter, sin iconos estridentes) -->
        <div class="py-6 border-y border-gray-200/80 my-7">
          <a 
            href="tel:+34602525866" 
            class="group inline-flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-3 transition-colors cursor-pointer"
            style="font-family: 'Inter', system-ui, -apple-system, sans-serif; letter-spacing: 0.05em;"
            aria-label="Llamar a PLB Reformas: +34 602 525 866"
          >
            <span 
              class="text-[11px] uppercase tracking-[0.2em] text-[#8C6B3C] font-medium select-none"
              style="letter-spacing: 0.2em;"
            >
              CONTACTO ·
            </span>
            <span 
              class="text-2xl sm:text-3xl lg:text-[2.1rem] leading-none transition-colors group-hover:text-[#8C6B3C]"
              style="font-weight: 300; color: #1E2229; letter-spacing: 0.05em;"
            >
              +34 602 525 866
            </span>
          </a>
        </div>

        <!-- Direct Channels -->
        <div class="space-y-5 pt-1">

          <div class="flex items-center gap-4">
            <div class="w-11 h-11 bg-[#25D366] text-white rounded-full flex items-center justify-center shrink-0 shadow-sm">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-0.5">{t.contact.whatsappLabel}</span>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-base font-bold text-[#111317] hover:text-[#25D366] transition-colors inline-flex items-center gap-1.5"
              >
                <span>{t.contact.whatsappCta}</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-11 h-11 bg-black text-gold-500 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-0.5">{t.contact.areaLabel}</span>
              <span class="text-sm font-semibold text-[#111317]">
                {t.contact.areaVal}
              </span>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Contact Form Box -->
      <div class="fade-up delay-100 lg:col-span-7 bg-[#f8fafc] p-8 sm:p-12 border border-gray-200 rounded-sm shadow-md">
        <h3 class="text-2xl font-extrabold uppercase tracking-tight text-[#111317] mb-2">
          {t.contact.formTitle}
        </h3>
        <p class="text-xs text-gray-500 mb-8 font-medium">
          {t.contact.formSubtitle}
        </p>

        <form id="contact-form" class="space-y-5">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">{t.contact.nameLabel}</label>
              <input 
                type="text" 
                name="name" 
                required 
                placeholder={t.contact.namePlaceholder} 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">{t.contact.phoneInputLabel}</label>
              <input 
                type="tel" 
                name="phone" 
                required 
                placeholder={t.contact.phonePlaceholder} 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">{t.contact.projectLabel}</label>
              <select 
                name="project" 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              >
                <option value="integral">{t.contact.projectOptions.integral}</option>
                <option value="chalet">{t.contact.projectOptions.chalet}</option>
                <option value="cocina">{t.contact.projectOptions.cocina}</option>
                <option value="bano">{t.contact.projectOptions.bano}</option>
                <option value="local">{t.contact.projectOptions.local}</option>
                <option value="otro">{t.contact.projectOptions.otro}</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">{t.contact.locationLabel}</label>
              <input 
                type="text" 
                name="location" 
                placeholder={t.contact.locationPlaceholder} 
                class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">{t.contact.messageLabel}</label>
            <textarea 
              name="message" 
              rows="4" 
              placeholder={t.contact.messagePlaceholder} 
              class="w-full px-4 py-3 bg-white border border-gray-300 text-sm text-[#111317] focus:border-gold-500 focus:outline-none rounded-sm transition-colors"
            ></textarea>
          </div>

          <div id="contact-feedback" class="hidden p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold uppercase tracking-wider">
            {t.contact.feedback}
          </div>

          <button 
            type="submit" 
            data-success-text={t.contact.submitSuccess}
            class="w-full py-4 bg-gold-500 hover:bg-gold-400 text-black font-extrabold text-sm uppercase tracking-widest rounded-sm shadow-md transition-colors cursor-pointer"
          >
            {t.contact.submitBtn}
          </button>

          <p class="text-[11px] text-center text-gray-500">
            {t.contact.privacyNote}
          </p>

        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('contact-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      feedback.classList.remove('hidden');
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        const successText = submitBtn.getAttribute('data-success-text') || "Solicitud Enviada Correctamente";
        submitBtn.textContent = successText;
        submitBtn.classList.remove('bg-gold-500', 'hover:bg-gold-400');
        submitBtn.classList.add('bg-black', 'text-white', 'cursor-not-allowed');
      }
    });
  }
</script>
