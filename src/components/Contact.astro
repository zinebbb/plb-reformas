---
---

<section id="contacto" class="py-24 bg-[#FAF8F5] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Contact Information -->
      <div class="lg:col-span-5">
        <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Primer Paso</span>
        <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-4">
          Hablemos sobre tu proyecto
        </h2>
        <p class="text-[#57534E] text-base leading-relaxed mb-8">
          Te ofrecemos una primera visita técnica gratuita. Analizamos la viabilidad de la reforma, te asesoramos en distribución y materiales, y te enviamos un presupuesto cerrado.
        </p>

        <div class="space-y-6">
          
          <!-- Phone Card -->
          <div class="bg-white p-5 rounded-2xl border border-[#EAE3D7] shadow-xs flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] flex items-center justify-center text-[#B58C42] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs text-[#78716C] font-medium">Llámanos directamente</div>
              <a href="tel:+34600000000" class="text-base font-semibold text-[#1F1D1A] hover:text-[#9C7334] transition-colors">
                +34 600 000 000
              </a>
            </div>
          </div>

          <!-- WhatsApp Card -->
          <div class="bg-white p-5 rounded-2xl border border-[#EAE3D7] shadow-xs flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <div class="text-xs text-[#78716C] font-medium">WhatsApp preferente</div>
              <a 
                href="https://wa.me/34600000000?text=Hola,%20quisiera%20solicitar%20un%20presupuesto%20para%20una%20reforma" 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-sm font-semibold text-emerald-700 hover:underline"
              >
                Abrir conversación directa →
              </a>
            </div>
          </div>

          <!-- Location Card -->
          <div class="bg-white p-5 rounded-2xl border border-[#EAE3D7] shadow-xs flex items-center gap-4">
            <div class="w-11 h-11 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] flex items-center justify-center text-[#B58C42] shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs text-[#78716C] font-medium">Área de Trabajo</div>
              <div class="text-sm font-semibold text-[#1F1D1A]">
                Reformas en toda la Comunidad y municipios limítrofes
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Form Box -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-10 rounded-3xl border border-[#EAE3D7] shadow-sm">
        <h3 class="text-2xl font-serif text-[#1F1D1A] mb-2">Solicita tu valoración gratuita</h3>
        <p class="text-xs sm:text-sm text-[#57534E] mb-8">Te responderemos en un plazo máximo de 24 horas laborables.</p>

        <form class="space-y-5" onsubmit="event.preventDefault(); alert('Gracias por tu mensaje. Nos pondremos en contacto contigo a la mayor brevedad.');">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-2">Nombre</label>
              <input 
                type="text" 
                required 
                placeholder="Tu nombre y apellidos" 
                class="w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#1F1D1A] placeholder-[#A8A29E] focus:outline-hidden focus:border-[#B58C42] focus:bg-white transition-all text-sm"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-2">Teléfono</label>
              <input 
                type="tel" 
                required 
                placeholder="600 000 000" 
                class="w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#1F1D1A] placeholder-[#A8A29E] focus:outline-hidden focus:border-[#B58C42] focus:bg-white transition-all text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-2">Tipo de Proyecto</label>
              <select 
                class="w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#1F1D1A] focus:outline-hidden focus:border-[#B58C42] focus:bg-white transition-all text-sm"
              >
                <option value="integral">Reforma Integral</option>
                <option value="cocina">Cocina a Medida</option>
                <option value="bano">Baño / Cambio de bañera</option>
                <option value="pintura">Pintura y Alisado</option>
                <option value="fontaneria">Fontanería o Electricidad</option>
                <option value="otro">Varios Servicios / Otros</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-2">Localidad / Zona</label>
              <input 
                type="text" 
                placeholder="Municipio o código postal" 
                class="w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#1F1D1A] placeholder-[#A8A29E] focus:outline-hidden focus:border-[#B58C42] focus:bg-white transition-all text-sm"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#1F1D1A] uppercase tracking-wider mb-2">Cuéntanos sobre tu espacio</label>
            <textarea 
              rows="4" 
              placeholder="Indícanos los metros aproximados, qué cambios te gustaría hacer o cuándo te gustaría empezar..." 
              class="w-full px-4 py-3 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#1F1D1A] placeholder-[#A8A29E] focus:outline-hidden focus:border-[#B58C42] focus:bg-white transition-all text-sm"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-4 rounded-full font-semibold text-white bg-[#1F1D1A] hover:bg-[#B58C42] shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer text-sm tracking-wide"
          >
            Enviar Consulta sin Compromiso
          </button>

          <p class="text-xs text-center text-[#78716C] mt-2">
            Compromiso de privacidad: No enviamos publicidad ni cedemos tus datos a nadie.
          </p>

        </form>
      </div>

    </div>

  </div>
</section>
