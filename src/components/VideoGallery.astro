---
const featuredProjects = [
  {
    id: "apt-1",
    title: "Vivienda Contemporánea con Luz Cálida Indirecta",
    category: "Reforma Integral",
    durationBadge: "18 seg · Tour Rápido",
    video: "/videos/featured-apartment.mp4",
    poster: "/images/gallery/thumb-featured-apt.jpg",
    specs: [
      { label: "Duración de obra", val: "5 semanas" },
      { label: "Material clave", val: "Suelo laminado AC5 & Roble" },
      { label: "Iluminación", val: "Foseados LED 3000K" }
    ],
    desc: "Redistribución completa de tabiquería, aislamiento acústico en paredes medianeras, panelado de madera natural y carpintería interior lacada en blanco."
  },
  {
    id: "kit-1",
    title: "Cocina de Diseño con Barra y Mobiliario a Medida",
    category: "Cocinas de Autor",
    durationBadge: "14 seg · Detalle",
    video: "/videos/featured-kitchen.mp4",
    poster: "/images/gallery/thumb-featured-kit.jpg",
    specs: [
      { label: "Duración de obra", val: "2 semanas" },
      { label: "Encimera", val: "Granito pulido de alta resistencia" },
      { label: "Distribución", val: "Lineal abierta con barra" }
    ],
    desc: "Fabricación de armarios con cierre amortiguado, integración oculta de electrodomésticos, fontanería multicapa y alicatado cerámico rectificado."
  },
  {
    id: "trans-1",
    title: "Fase de Demolición y Proceso de Transformación",
    category: "Evolución en Directo",
    durationBadge: "10 seg · Obra Real",
    video: "/videos/featured-transition.mp4",
    poster: "/images/gallery/thumb-featured-tra.jpg",
    specs: [
      { label: "Seguridad", val: "Protección integral comunitaria" },
      { label: "Desescombro", val: "Contenedores homologados" },
      { label: "Estructura", val: "Apertura de huecos diáfanos" }
    ],
    desc: "Retirada meticulosa de tabiquería antigua sin dañar elementos estructurales, canalizaciones de instalaciones y saneado de solera."
  }
];
---

<section id="obras" class="py-24 bg-[#F4EFE8] border-t border-[#EAE3D7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="fade-up text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Selección de Proyectos</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-3">
        Obras destacadas en vídeo
      </h2>
      <p class="text-[#57534E] text-sm sm:text-base leading-relaxed">
        Hemos seleccionado 3 intervenciones clave editadas en formato breve para que aprecies los detalles constructivos y la calidad final sin perder tiempo.
      </p>
    </div>

    <!-- 3 Featured Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {featuredProjects.map((item, idx) => (
        <div 
          class={`fade-up delay-${(idx + 1) * 100} bg-white rounded-3xl overflow-hidden border border-[#EAE3D7] shadow-sm hover:shadow-xl hover:border-[#B58C42]/50 transition-all duration-300 flex flex-col justify-between group`}
        >
          
          <!-- Top Video Frame -->
          <div>
            <div class="relative aspect-video bg-[#1F1D1A] overflow-hidden">
              <video 
                id={`featured-vid-${item.id}`}
                controls 
                preload="metadata"
                poster={item.poster}
                class="w-full h-full object-cover"
              >
                <source src={item.video} type="video/mp4" />
                Tu navegador no soporta la reproducción de vídeo.
              </video>
              
              <!-- Category Badge -->
              <div class="absolute top-3 left-3 bg-[#1F1D1A]/85 backdrop-blur-md text-[#dec593] text-[11px] font-semibold px-3 py-1 rounded-full border border-[#B58C42]/30 pointer-events-none">
                {item.category}
              </div>

              <!-- Duration Badge -->
              <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-md text-[#1F1D1A] text-[10px] font-medium px-2.5 py-1 rounded-full pointer-events-none">
                {item.durationBadge}
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6">
              <h3 class="font-serif font-bold text-lg text-[#1F1D1A] mb-2 leading-snug group-hover:text-[#9C7334] transition-colors">
                {item.title}
              </h3>
              
              <p class="text-xs sm:text-sm text-[#57534E] leading-relaxed mb-6">
                {item.desc}
              </p>

              <!-- Technical Specs List -->
              <div class="space-y-2 py-4 border-t border-[#F4EFE8] text-xs">
                {item.specs.map(spec => (
                  <div class="flex items-center justify-between">
                    <span class="text-[#78716C] font-medium">{spec.label}</span>
                    <span class="text-[#1F1D1A] font-semibold">{spec.val}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom CTA -->
          <div class="px-6 pb-6 pt-2">
            <a 
              href="#contacto" 
              class="w-full py-3 rounded-xl font-medium text-xs text-center text-[#1F1D1A] bg-[#FAF8F5] hover:bg-[#1F1D1A] hover:text-white border border-[#EAE3D7] transition-all duration-300 flex items-center justify-center gap-2"
            >
              <span>Consultar proyecto similar</span>
              <span>→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
