---
---

<section 
  class="relative h-screen min-h-[640px] w-full flex flex-col justify-end text-white overflow-hidden"
  style="font-family: 'Outfit', sans-serif;"
>
  
  <!-- Cinematic Background Video (Benidorm & Costa Blanca mix) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      poster="/images/hero-benidorm-poster.jpg" 
      class="w-full h-full object-cover"
    >
      <source src="/videos/hero-benidorm-costa-blanca.mp4" type="video/mp4" />
    </video>
    
    <!-- Flat Dark Contrast Overlay (Clean contrast so white text floats clearly) -->
    <div class="absolute inset-0 bg-black/45"></div>
  </div>

  <!-- Main Text Container (Bottom-Left corner, aligned to the left, floating cleanly) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 pb-20 sm:pb-24 lg:pb-28 text-left">
    <div class="max-w-3xl text-left">
      
      <!-- Main Title: Outfit, Grosor extrafino (font-weight: 200), Grande y limpio, line-height: 1.15, text-shadow: none -->
      <h1 
        class="hero-title text-white mb-4 sm:mb-5 text-left"
        style="font-family: 'Outfit', system-ui, -apple-system, sans-serif; font-size: clamp(2.35rem, 5.2vw, 3.8rem); font-weight: 200; line-height: 1.15; color: #ffffff; text-shadow: none; letter-spacing: -0.02em;"
      >
        Construcción y Reformas Integrales <br class="hidden sm:inline" />
        en la Comunidad Valenciana
      </h1>

      <!-- Subtitle: Outfit, font-weight: 300, color: rgba(255, 255, 255, 0.85), line-height: 1.6, text-shadow: none, Sin Benidorm -->
      <p 
        class="hero-subtitle text-sm sm:text-base md:text-lg max-w-2xl mb-6 sm:mb-8 text-left"
        style="font-family: 'Outfit', system-ui, -apple-system, sans-serif; font-weight: 300; line-height: 1.6; color: rgba(255, 255, 255, 0.85); text-shadow: none;"
      >
        Especialistas en reformas integrales de viviendas, chalets, cocinas y baños en la Comunidad Valenciana. Proyectos llave en mano con dirección técnica propia.
      </p>

      <!-- Fina barra horizontal blanca fija justo debajo del texto -->
      <div 
        class="hero-divider w-32 sm:w-48 h-[1px] bg-white" 
        style="height: 1px; background-color: #ffffff;"
        aria-hidden="true"
      ></div>

    </div>
  </div>

  <!-- Indicador de Scroll: Parte inferior central, texto pequeño semi-transparente -->
  <div class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 z-20 text-center pointer-events-none select-none">
    <span 
      class="text-[11px] sm:text-xs tracking-[0.25em] uppercase font-light block"
      style="font-family: 'Outfit', system-ui, -apple-system, sans-serif; font-weight: 300; color: rgba(255, 255, 255, 0.7); text-shadow: none;"
    >
      Haz scroll para continuar
    </span>
    <div class="w-[1px] h-3.5 bg-white/40 mx-auto mt-2"></div>
  </div>

</section>

<style>
  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.15rem !important;
      line-height: 1.15 !important;
    }
  }
</style>
