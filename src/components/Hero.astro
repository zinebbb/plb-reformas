---
---

<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 bg-gradient-to-b from-[#10141d] via-[#141a26] to-[#0f131a]">
  <!-- Decorative background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto">
      
      <!-- Top Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6 animate-pulse">
        <span>✨ Excelencia en Reformas & Multisericios</span>
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Reformamos tu espacio con <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500">calidad premium</span>
      </h1>

      <!-- Description -->
      <p class="text-lg sm:text-xl text-slate-300 mb-10 leading-relaxed font-light">
        Especialistas en reformas integrales, cocinas, baños, albañilería, fontanería, electricidad y pintura. Nos encargamos de todo el proceso para que tú solo disfrutes del resultado.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#contacto" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-slate-950 bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-300 hover:to-gold-400 shadow-xl shadow-gold-500/25 transition-all duration-300 transform hover:-translate-y-0.5 text-center text-base"
        >
          Solicitar Presupuesto Gratis
        </a>
        <a 
          href="#proyectos" 
          class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-white bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700 transition-all duration-300 text-center text-base flex items-center justify-center gap-2"
        >
          <span>Ver Vídeos de Obras</span>
          <svg class="w-5 h-5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 pt-10 border-t border-slate-800/80 text-center">
        <div>
          <div class="text-3xl font-extrabold text-gold-400">+10</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1">Años de Experiencia</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-gold-400">100%</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1">Garantía Profesional</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-gold-400">360°</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1">Servicio Llave en Mano</div>
        </div>
        <div>
          <div class="text-3xl font-extrabold text-gold-400">0€</div>
          <div class="text-xs sm:text-sm text-slate-400 mt-1">Presupuesto sin Compromiso</div>
        </div>
      </div>

    </div>
  </div>
</section>
