---
---

<section class="relative min-h-[92vh] flex items-center justify-center text-white overflow-hidden pt-28 pb-16">
  
  <!-- Cinematic Background Video -->
  <div class="absolute inset-0 z-0">
    <video 
      autoplay 
      loop 
      muted 
      playsinline 
      poster="/images/hero-benidorm-poster.jpg" 
      class="w-full h-full object-cover"
    >
      <source src="/videos/hero-benidorm-costa-blanca.mp4" type="video/mp4" />
    </video>
    
    <!-- Clean Dark Overlay (Alfa Interiorismo Style) -->
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <!-- Content Container -->
  <div class="max-w-5xl mx-auto px-4 sm:px-8 relative z-10 text-center w-full">
    
    <!-- Main Headline (Alfa Interiorismo Style: Pure, Bold, Uppercase) -->
    <h1 class="fade-up text-3xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-tight leading-tight text-white mb-6">
      Construcción y Reformas Integrales <br />
      <span class="text-gold-500">en la Comunidad Valenciana</span>
    </h1>

    <!-- Subtitle (Clean & Direct) -->
    <p class="fade-up delay-100 text-sm sm:text-lg md:text-xl text-gray-200 max-w-3xl mx-auto font-normal leading-relaxed mb-10">
      Especialistas en reformas integrales de viviendas, chalets, cocinas y baños en Benidorm y toda la Comunidad Valenciana. Proyectos llave en mano con dirección técnica propia.
    </p>

    <!-- Single Main CTA Button (Alfa Interiorismo Style) -->
    <div class="fade-up delay-200 mb-16">
      <a 
        href="#contacto" 
        class="inline-block px-10 py-4 rounded-sm text-sm font-extrabold uppercase tracking-widest text-black bg-gold-500 hover:bg-gold-400 transition-colors duration-200 shadow-lg text-center"
      >
        Obtener Presupuesto!
      </a>
    </div>

    <!-- 3 Signature Value Pillars (Direct from Alfa Interiorismo) -->
    <div class="fade-up delay-300 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
      
      <div class="bg-black/75 backdrop-blur-sm p-6 rounded-sm border border-white/10 hover:border-gold-500 transition-colors">
        <div class="w-10 h-10 rounded-sm bg-white/10 text-gold-500 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-white uppercase tracking-wider mb-1">Proyecto Integral</h3>
        <p class="text-xs text-gray-300 font-light leading-relaxed">
          Desarrollo de proyectos llave en mano
        </p>
      </div>

      <div class="bg-black/75 backdrop-blur-sm p-6 rounded-sm border border-white/10 hover:border-gold-500 transition-colors">
        <div class="w-10 h-10 rounded-sm bg-white/10 text-gold-500 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-white uppercase tracking-wider mb-1">Garantía por Contrato</h3>
        <p class="text-xs text-gray-300 font-light leading-relaxed">
          Servicio de mantenimiento de trabajos realizados durante 2 años
        </p>
      </div>

      <div class="bg-black/75 backdrop-blur-sm p-6 rounded-sm border border-white/10 hover:border-gold-500 transition-colors">
        <div class="w-10 h-10 rounded-sm bg-white/10 text-gold-500 flex items-center justify-center mb-4">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-white uppercase tracking-wider mb-1">Pago por Etapas</h3>
        <p class="text-xs text-gray-300 font-light leading-relaxed">
          El pago se realiza después de cada etapa certificada
        </p>
      </div>

    </div>

  </div>
</section>
