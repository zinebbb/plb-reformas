---
---

<section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-[#FAF8F5] via-[#F4EFE8] to-[#FAF8F5]">
  
  <!-- Subtle architectural background lines -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none bg-[radial-gradient(#1F1D1A_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto text-center">
      
      <!-- Top Trust Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-[#EAE3D7] text-[#9C7334] text-xs font-semibold tracking-wider uppercase shadow-xs mb-8">
        <svg class="w-3.5 h-3.5 text-[#B58C42]" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span>Empresa de Reformas Integrales y Multiservicios</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-[#1F1D1A] leading-tight tracking-tight mb-6">
        Reformas con calma, <br class="hidden sm:inline" />
        <span class="italic font-normal text-[#9C7334]">rigor y garantía</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-[#57534E] mb-10 leading-relaxed font-light">
        Cuidamos cada detalle de tu vivienda o negocio. Te acompañamos desde el primer plano hasta la entrega de llaves, con presupuesto cerrado por escrito y cumplimiento riguroso de plazos.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#contacto" 
          class="w-full sm:w-auto px-8 py-4 rounded-full font-medium text-white bg-[#1F1D1A] hover:bg-[#B58C42] shadow-sm hover:shadow-md transition-all duration-300 text-center text-sm tracking-wide"
        >
          Solicitar Presupuesto Gratuito
        </a>
        <a 
          href="#obras" 
          class="w-full sm:w-auto px-8 py-4 rounded-full font-medium text-[#1F1D1A] bg-white hover:bg-[#F4EFE8] border border-[#EAE3D7] shadow-xs transition-all duration-300 text-center text-sm flex items-center justify-center gap-2.5"
        >
          <svg class="w-4 h-4 text-[#B58C42]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Ver Vídeos de Obras</span>
        </a>
      </div>

      <!-- Trust Badges Bar -->
      <div class="mt-16 pt-8 border-t border-[#EAE3D7] grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-3">
          <div class="text-2xl font-serif font-bold text-[#1F1D1A]">+15</div>
          <div class="text-xs text-[#78716C] mt-1 font-medium">Años de oficio</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-serif font-bold text-[#1F1D1A]">100%</div>
          <div class="text-xs text-[#78716C] mt-1 font-medium">Presupuesto cerrado</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-serif font-bold text-[#1F1D1A]">1</div>
          <div class="text-xs text-[#78716C] mt-1 font-medium">Interlocutor único</div>
        </div>
        <div class="p-3">
          <div class="text-2xl font-serif font-bold text-[#1F1D1A]">2 Años</div>
          <div class="text-xs text-[#78716C] mt-1 font-medium">Garantía por escrito</div>
        </div>
      </div>

    </div>
  </div>
</section>
