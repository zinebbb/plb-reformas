---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
const homeUrl = lang === 'es' ? '/' : `/${lang}/`;

function getSectionHref(hash: string) {
  if (hash === '#') return homeUrl;
  return `${homeUrl}${hash}`;
}
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 pointer-events-none">
  <!-- Sutil degradado detrás de la cabecera solo cuando está transparente sobre el vídeo -->
  <div class="header-ambient-gradient pointer-events-none" aria-hidden="true"></div>

  <div class="header-inner max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 flex items-center justify-between relative z-10">
    
    <!-- Bloque del Logotipo Corporativo -->
    <a 
      href={homeUrl} 
      class="inline-flex items-end gap-3 group pointer-events-auto" 
      aria-label="PLB Reformas Premium, inicio"
    >
      <!-- Icono del Imagotipo (fondo transparente) -->
      <img 
        src="/images/logo-icon-white.png" 
        alt="PLB Reformas Imagotipo" 
        class="header-logo-img h-9 sm:h-11 w-auto object-contain shrink-0"
      />

      <!-- Texto de Identidad -->
      <div class="flex flex-col justify-end pb-1 sm:pb-1.5">
        <span 
          class="header-brand-title text-[9px] sm:text-[10px] uppercase font-light tracking-[0.22em] leading-none select-none"
          style="font-family: 'Montserrat', system-ui, -apple-system, sans-serif; font-weight: 300; letter-spacing: 0.22em;"
        >
          <span class="header-brand-name">{t.header.brandName}</span> <span class="header-brand-highlight">{t.header.brandHighlight}</span>
        </span>
      </div>
    </a>

    <!-- Right Side: Navigation Menu & Language Selector -->
    <div class="flex items-center gap-6 lg:gap-8">
      
      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 pointer-events-auto" aria-label="Navegación principal">
        <a 
          href={getSectionHref('#servicios')} 
          data-section="servicios"
          class="header-nav-link"
        >
          {t.header.nav.services}
        </a>
        <a 
          href={getSectionHref('#nosotros')} 
          data-section="nosotros"
          class="header-nav-link"
        >
          {t.header.nav.about}
        </a>
        <!-- Enlace 'Obras' oculto temporalmente; reactivar cuando haya fotos disponibles -->
        <!--
        <a 
          href={getSectionHref('#proyectos')} 
          data-section="proyectos"
          class="header-nav-link"
        >
          {t.header.nav.projects}
        </a>
        -->
        <a 
          href={getSectionHref('#proceso')} 
          data-section="proceso"
          class="header-nav-link"
        >
          {t.header.nav.process}
        </a>
        <a 
          href={getSectionHref('#contacto')} 
          class="header-nav-btn--contact"
        >
          {t.header.nav.contact}
        </a>
      </nav>

      <!-- Desktop Language Selector: ES / EN -->
      <div class="hidden md:flex items-center gap-1.5 text-[13px] font-medium tracking-[0.14em] uppercase select-none pointer-events-auto header-lang-switch">
        <a 
          href="/" 
          data-base-href="/" 
          class={`lang-link ${lang === 'es' ? 'opacity-100 font-semibold' : 'opacity-55 hover:opacity-100'} transition-opacity duration-300`}
          aria-label="Versión en Español"
          aria-current={lang === 'es' ? 'true' : undefined}
        >
          ES
        </a>
        <span class="opacity-40 text-[11px] font-light select-none">/</span>
        <a 
          href="/en/" 
          data-base-href="/en/" 
          class={`lang-link ${lang === 'en' ? 'opacity-100 font-semibold' : 'opacity-55 hover:opacity-100'} transition-opacity duration-300`}
          aria-label="English version"
          aria-current={lang === 'en' ? 'true' : undefined}
        >
          EN
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="header-mobile-btn md:hidden inline-flex items-center justify-center p-2 focus:outline-none pointer-events-auto"
        aria-expanded="false"
        aria-label={t.header.mobileMenuAria}
      >
        <svg id="menu-icon-open" class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden mobile-drawer px-6 py-6 pointer-events-auto"
  >
    <nav class="flex flex-col space-y-3.5 mb-6" aria-label="Navegación móvil">
      <a 
        href={getSectionHref('#servicios')} 
        class="mobile-nav-link text-[13px] font-medium tracking-[0.14em] uppercase py-1.5"
      >
        {t.header.nav.services}
      </a>
      <a 
        href={getSectionHref('#nosotros')} 
        class="mobile-nav-link text-[13px] font-medium tracking-[0.14em] uppercase py-1.5"
      >
        {t.header.nav.about}
      </a>
      <!-- Enlace 'Obras' oculto temporalmente; reactivar cuando haya fotos disponibles -->
      <!--
      <a 
        href={getSectionHref('#proyectos')} 
        class="mobile-nav-link text-[13px] font-medium tracking-[0.14em] uppercase py-1.5"
      >
        {t.header.nav.projects}
      </a>
      -->
      <a 
        href={getSectionHref('#proceso')} 
        class="mobile-nav-link text-[13px] font-medium tracking-[0.14em] uppercase py-1.5"
      >
        {t.header.nav.process}
      </a>
      
      <!-- Contacto como botón a ancho completo al final -->
      <a 
        href={getSectionHref('#contacto')} 
        class="mobile-nav-link mobile-nav-btn--contact text-center w-full mt-2"
      >
        {t.header.nav.contact}
      </a>
    </nav>

    <!-- Mobile Language Selector: ES / EN -->
    <div class="pt-4 border-t border-black/10 flex items-center justify-center gap-2 text-[13px] font-medium tracking-[0.14em] uppercase header-lang-switch">
      <a
        href="/"
        data-base-href="/"
        class={`lang-link ${lang === 'es' ? 'opacity-100 font-semibold' : 'opacity-55 hover:opacity-100'} transition-opacity duration-300`}
        aria-label="Versión en Español"
        aria-current={lang === 'es' ? 'true' : undefined}
      >
        ES
      </a>
      <span class="opacity-40 text-[11px] font-light select-none">/</span>
      <a
        href="/en/"
        data-base-href="/en/"
        class={`lang-link ${lang === 'en' ? 'opacity-100 font-semibold' : 'opacity-55 hover:opacity-100'} transition-opacity duration-300`}
        aria-label="English version"
        aria-current={lang === 'en' ? 'true' : undefined}
      >
        EN
      </a>
    </div>
  </div>
</header>

<style>
  /* 1. Cabecera sobre la portada (scroll en la parte superior): fondo transparente */
  #site-header {
    transform: translateY(0);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
                background-color 300ms ease,
                border-color 300ms ease,
                backdrop-filter 300ms ease,
                -webkit-backdrop-filter 300ms ease;
  }

  /* Sutil degradado detrás de la cabecera solo cuando está transparente sobre el vídeo */
  .header-ambient-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 140px;
    background: linear-gradient(to bottom, rgba(10, 14, 22, 0.35), rgba(10, 14, 22, 0));
    pointer-events: none;
    opacity: 1;
    transition: opacity 300ms ease;
    z-index: 0;
  }

  #site-header.header--solid .header-ambient-gradient,
  #site-header.header--menu-open .header-ambient-gradient {
    opacity: 0;
  }

  /* Padding vertical: normal sobre la portada */
  .header-inner {
    padding-top: 1rem;       /* 16px */
    padding-bottom: 1rem;    /* 16px */
    transition: padding 300ms ease;
  }
  @media (min-width: 640px) {
    .header-inner {
      padding-top: 1.25rem;  /* 20px */
      padding-bottom: 1.25rem; /* 20px */
    }
  }

  /* 2. Oculto al bajar pasada la portada */
  #site-header.header--hidden {
    transform: translateY(-100%);
    pointer-events: none !important;
  }

  /* 3. Reaparece al subir (Sólido translúcido arquitectónico) */
  #site-header.header--solid {
    background-color: rgba(247, 245, 240, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: none;
    pointer-events: auto;
  }

  /* Padding vertical más compacto al reaparecer (20% de reducción) */
  #site-header.header--solid .header-inner {
    padding-top: 0.8rem;    /* 12.8px (16px - 20%) */
    padding-bottom: 0.8rem; /* 12.8px (16px - 20%) */
  }
  @media (min-width: 640px) {
    #site-header.header--solid .header-inner {
      padding-top: 1rem;    /* 16px (20px - 20%) */
      padding-bottom: 1rem; /* 16px (20px - 20%) */
    }
  }

  /* Logotipo */
  .header-logo-img {
    filter: none;
    transition: filter 300ms ease;
  }
  #site-header.header--solid .header-logo-img,
  #site-header.header--menu-open .header-logo-img {
    filter: invert(1) brightness(0.1);
  }

  /* Texto de Identidad de Marca */
  .header-brand-name {
    color: #ffffff;
    transition: color 300ms ease;
  }
  .header-brand-highlight {
    color: #C5A880;
    font-weight: 500;
    transition: color 300ms ease;
  }
  #site-header.header--solid .header-brand-name,
  #site-header.header--menu-open .header-brand-name {
    color: #1a1a1a;
  }
  #site-header.header--solid .header-brand-highlight,
  #site-header.header--menu-open .header-brand-highlight {
    color: #8C6B3C;
  }

  /* 2. TIPOGRAFÍA DEL MENÚ DE ESCRITORIO */
  .header-nav-link {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    position: relative;
    padding-top: 4px;
    padding-bottom: 4px;
    text-decoration: none;
    display: inline-block;
    transition: color 300ms ease, opacity 300ms ease;
  }

  #site-header.header--solid .header-nav-link {
    color: #1a1a1a;
  }

  .header-nav-link:hover {
    color: #ffffff;
    opacity: 1;
  }

  #site-header.header--solid .header-nav-link:hover {
    color: #1a1a1a;
    opacity: 1;
  }

  /* Hover & Sección activa: línea de 1px dibujada de izquierda a derecha en 300ms */
  .header-nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: #B08D6A;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .header-nav-link:hover::after,
  .header-nav-link.is-active::after {
    transform: scaleX(1);
  }

  /* 3. "CONTACTO" COMO BOTÓN SUTIL */
  .header-nav-btn--contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    padding: 10px 22px;
    background-color: transparent;
    text-decoration: none;
    transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease;
  }

  .header-nav-btn--contact:hover {
    background-color: #B08D6A;
    color: #ffffff;
    border-color: #B08D6A;
  }

  #site-header.header--solid .header-nav-btn--contact {
    color: #1a1a1a;
    border-color: rgba(26, 26, 26, 0.7);
    background-color: transparent;
  }

  #site-header.header--solid .header-nav-btn--contact:hover {
    background-color: #B08D6A;
    color: #ffffff;
    border-color: #B08D6A;
  }

  /* 5. SELECTOR DE IDIOMA */
  .header-lang-switch {
    color: rgba(255, 255, 255, 0.92);
    transition: color 300ms ease;
  }

  #site-header.header--solid .header-lang-switch,
  #site-header.header--menu-open .header-lang-switch,
  .mobile-drawer .header-lang-switch {
    color: #1a1a1a;
  }

  .header-lang-switch a {
    text-decoration: none;
    color: inherit;
  }

  /* Botón Hamburguesa Móvil */
  .header-mobile-btn {
    color: #ffffff;
    transition: color 300ms ease;
  }
  .header-mobile-btn:hover {
    color: #B08D6A;
  }
  #site-header.header--solid .header-mobile-btn,
  #site-header.header--menu-open .header-mobile-btn {
    color: #1a1a1a;
  }

  /* Móvil con Menú Abierto */
  #site-header.header--menu-open {
    transform: translateY(0) !important;
    background-color: rgba(247, 245, 240, 0.98) !important;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    pointer-events: auto;
  }

  /* Cajón Menú Móvil */
  .mobile-drawer {
    background-color: rgba(247, 245, 240, 0.98);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.08);
  }
  .mobile-nav-link {
    color: #1a1a1a;
    transition: color 200ms ease;
    text-decoration: none;
  }
  .mobile-nav-link:hover {
    color: #B08D6A;
  }

  /* Botón Contacto en Menú Móvil (ancho completo al final) */
  .mobile-nav-btn--contact {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
    border: 1px solid rgba(26, 26, 26, 0.7);
    border-radius: 2px;
    padding: 11px 22px;
    background-color: transparent;
    text-decoration: none;
    transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease;
  }

  .mobile-nav-btn--contact:hover,
  .mobile-nav-btn--contact:active {
    background-color: #B08D6A;
    color: #ffffff;
    border-color: #B08D6A;
  }

  /* Accesibilidad: Respetar prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    #site-header,
    #site-header *,
    .header-inner,
    .header-logo-img,
    .header-brand-name,
    .header-brand-highlight,
    .header-nav-link,
    .header-nav-link::after,
    .header-nav-btn--contact,
    .mobile-drawer,
    .mobile-nav-link,
    .mobile-nav-btn--contact,
    .header-ambient-gradient {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  // 1. Control de scroll y visibilidad de cabecera con requestAnimationFrame
  const header = document.getElementById('site-header');
  let lastScrollY = typeof window !== 'undefined' ? window.scrollY : 0;
  let ticking = false;

  function getHeroThreshold(): number {
    const hero = document.querySelector('section');
    return hero ? Math.max(hero.offsetHeight - 100, 300) : 400;
  }

  function handleScrollUpdate() {
    if (!header) return;

    // Con el menú móvil abierto, no ocultar la cabecera
    if (header.classList.contains('header--menu-open')) {
      ticking = false;
      return;
    }

    const currentScrollY = Math.max(0, window.scrollY);
    const heroThreshold = getHeroThreshold();
    const delta = currentScrollY - lastScrollY;

    // 1. Arriba del todo (scroll = 0 o muy cerca de 0)
    if (currentScrollY <= 15) {
      header.classList.remove('header--hidden');
      header.classList.remove('header--solid');
    }
    // 2. Pasada la portada
    else if (currentScrollY > heroThreshold) {
      // Al bajar: ocultar suavemente (transform: translateY(-100%))
      if (delta > 4) {
        header.classList.add('header--hidden');
      }
      // Al subir: reaparecer con estilo sólido
      else if (delta < -4) {
        header.classList.remove('header--hidden');
        header.classList.add('header--solid');
      }
    }
    // 3. Dentro de la portada (entre 15px y heroThreshold)
    else {
      // Si el usuario sube desde abajo con el estilo sólido, mantenerlo visible
      if (delta < -4 && header.classList.contains('header--solid')) {
        header.classList.remove('header--hidden');
      }
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(handleScrollUpdate);
      ticking = true;
    }
  }, { passive: true });

  // 2. Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  if (mobileMenuBtn && mobileDrawer && header) {
    function openMobileMenu() {
      mobileDrawer?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
      header?.classList.add('header--menu-open');
      header?.classList.remove('header--hidden');
    }

    function closeMobileMenu() {
      mobileDrawer?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      header?.classList.remove('header--menu-open');
      handleScrollUpdate();
    }

    mobileMenuBtn.addEventListener('click', () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Cerrar al hacer clic en enlaces de navegación móvil
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    // Cerrar drawer en caso de redimensionar a pantalla de escritorio
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && header.classList.contains('header--menu-open')) {
        closeMobileMenu();
      }
    }, { passive: true });
  }

  // 3. Preservar hash de sección al cambiar de idioma
  document.querySelectorAll('a.lang-link').forEach((link) => {
    link.addEventListener('click', () => {
      const hash = window.location.hash;
      if (hash) {
        const baseHref = link.getAttribute('data-base-href');
        if (baseHref) {
          (link as HTMLAnchorElement).href = baseHref.endsWith('/') ? `${baseHref}${hash}` : `${baseHref}/${hash}`;
        }
      }
    });
  });

  // 4. SECCIÓN ACTIVA: IntersectionObserver para marcar la sección visible con línea de 1px en bronce
  const sectionIds = ['servicios', 'nosotros', 'proceso'];
  const desktopNavLinks = document.querySelectorAll<HTMLAnchorElement>('.header-nav-link[data-section]');

  if ('IntersectionObserver' in window && desktopNavLinks.length > 0) {
    const intersectingSections = new Set<string>();

    function updateActiveSectionIndicator() {
      let activeId: string | null = null;
      let minDistance = Infinity;
      const targetPoint = window.innerHeight * 0.35; // Punto focal superior/medio

      intersectingSections.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          const rect = el.getBoundingClientRect();
          // La sección abarca el punto focal
          if (rect.top <= targetPoint && rect.bottom >= targetPoint) {
            activeId = id;
            minDistance = -1;
          } else if (minDistance !== -1) {
            const dist = Math.abs(rect.top - targetPoint);
            if (dist < minDistance) {
              minDistance = dist;
              activeId = id;
            }
          }
        }
      });

      desktopNavLinks.forEach((link) => {
        const sec = link.getAttribute('data-section');
        if (activeId && sec === activeId) {
          link.classList.add('is-active');
        } else {
          link.classList.remove('is-active');
        }
      });
    }

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            intersectingSections.add(entry.target.id);
          } else {
            intersectingSections.delete(entry.target.id);
          }
        });
        updateActiveSectionIndicator();
      },
      {
        root: null,
        rootMargin: '0px 0px -25% 0px',
        threshold: [0, 0.1, 0.25, 0.5]
      }
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) sectionObserver.observe(el);
    });

    window.addEventListener('scroll', () => {
      if (intersectingSections.size > 0) {
        updateActiveSectionIndicator();
      }
    }, { passive: true });
  }
</script>
