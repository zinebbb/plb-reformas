---
const pillars = [
  {
    title: "Rápido y Plazos Cumplidos",
    desc: "Fijamos contractualmente la fecha de inicio y de entrega de llaves. Cumplimos escrupulosamente los tiempos pactados para tu tranquilidad.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`
  },
  {
    title: "Contrato Oficial y Precio Cerrado",
    desc: "Presupuesto transparente y detallado partida a partida. Lo que firmas es exactamente lo que pagas, sin sorpresas ni sobrecostes.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`
  },
  {
    title: "Limpieza Rigurosa Post-Obra",
    desc: "Cuidamos las zonas comunes del edificio, ascensores y portales. Al finalizar, entregamos la vivienda impecable, lista para entrar a vivir.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`
  },
  {
    title: "Pago por Etapas Certificadas",
    desc: "No exigimos desembolsos totales por adelantado. Los pagos se estructuran en fases vinculadas al avance real de los trabajos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>`
  },
  {
    title: "Garantía Oficial por Contrato",
    desc: "Entregamos documento oficial de garantía por 2 años en todas nuestras instalaciones y revestimientos, con servicio de asistencia técnica.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`
  },
  {
    title: "Equipo Multidisciplinar Propio",
    desc: "Sin intermediarios. Albañiles, fontaneros, instaladores y carpinteros supervisados por un jefe de obra dedicado en Benidorm.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>`
  }
];
---

<section id="garantias" class="py-24 bg-[#0f1115] text-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Header (Alfa Interiorismo Style) -->
    <div class="fade-up text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold tracking-widest uppercase text-gold-500 block mb-2">
        NOSOTROS
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-white mb-4">
        Por Qué Elegir PLB Reformas
      </h2>
      <div class="w-16 h-1 bg-gold-500 mx-auto mb-5"></div>
      <p class="text-sm sm:text-base text-gray-400 leading-relaxed font-normal">
        Trabajamos bajo estándares rigurosos de calidad en Benidorm y la Costa Blanca, ofreciendo compromisos reales que protegen tu inversión.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {pillars.map((item, idx) => (
        <div 
          class={`fade-up delay-${(idx % 3) * 100} p-8 bg-[#16191f] border border-white/10 hover:border-gold-500 transition-all duration-300 rounded-sm flex flex-col justify-between group`}
        >
          <div>
            <div class="w-12 h-12 rounded-sm bg-black/40 border border-gold-500/30 text-gold-500 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </div>

            <h3 class="text-lg font-bold text-white uppercase tracking-wide mb-3 group-hover:text-gold-400 transition-colors">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
