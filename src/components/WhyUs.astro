---
const guarantees = [
  {
    title: "Presupuesto Cerrado por Escrito",
    desc: "Detallamos cada partida con transparencia absoluta. Lo que firmas es exactamente lo que pagas, sin costes imprevistos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`
  },
  {
    title: "Compromiso Firme de Plazos",
    desc: "Establecemos una fecha fija de inicio y de finalización en el contrato para que puedas organizar tu vida con total certidumbre.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`
  },
  {
    title: "Seguro de Responsabilidad Civil",
    desc: "Toda la obra está cubierta por póliza profesional de seguro para proteger tu vivienda y todas las zonas comunes de la finca.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`
  },
  {
    title: "Materiales Homologados de Alta Gama",
    desc: "Trabajamos exclusivamente con fabricantes reconocidos con certificados de calidad europea y máxima durabilidad.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`
  },
  {
    title: "Limpieza Diaria y Respeto Comunitario",
    desc: "Protegemos ascensores y rellanos, respetamos los horarios de descanso vecinal y dejamos la vivienda impecable tras cada jornada.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"/>`
  },
  {
    title: "Garantía Oficial de 2 Años",
    desc: "Entregamos un documento formal de garantía para que tengas asistencia técnica inmediata y total respaldo post-obra.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>`
  }
];
---

<section id="garantias" class="py-24 bg-[#F4EFE8] border-t border-[#EAE3D7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Tranquilidad Garantizada</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-4">
        Tu reforma con total seguridad
      </h2>
      <p class="text-[#57534E] text-base leading-relaxed">
        Reformar una casa no tiene por qué ser una experiencia estresante. Construimos confianza con hechos, contratos claros y garantías oficiales.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guarantees.map((item) => (
        <div class="bg-white p-8 rounded-2xl border border-[#EAE3D7] shadow-xs flex flex-col justify-between hover:border-[#B58C42]/50 hover:shadow-md transition-all duration-300">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#FAF8F5] border border-[#EAE3D7] text-[#B58C42] flex items-center justify-center mb-5">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
            </div>
            <h3 class="text-base font-semibold text-[#1F1D1A] mb-2">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#57534E] leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
