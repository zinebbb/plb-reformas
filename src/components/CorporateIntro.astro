---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = (Astro.currentLocale as Lang) || 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section 
  id="presentacion" 
  class="relative bg-white text-[#1E2229] py-24 sm:py-32 lg:py-36 overflow-hidden border-b border-gray-100" 
  style="font-family: 'Outfit', 'Inter', system-ui, -apple-system, sans-serif;"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- BLOQUE 1: Presentación Corporativa (Maquetación Asimétrica & Editorial de Lujo) -->
    <div class="filosofia fade-up">
      
      <!-- Antetítulo -->
      <span 
        class="text-[10px] sm:text-[11px] font-normal uppercase text-[#C5A880] block mb-6 select-none"
        style="letter-spacing: 0.28em; color: #C5A880;"
      >
        {t.intro.eyebrow1}
      </span>

      <!-- Titular Principal (H2): Fraunces peso 200 via CSS global -->
      <h2 class="max-w-4xl text-left" style="font-size: clamp(2.8rem, 6vw, 5.5rem); line-height: 1.05;">
        {t.intro.title1}
      </h2>

      <!-- Desplazamiento Asimétrico de Columnas & Párrafos inferiores -->
      <div 
        class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 lg:gap-20 text-left items-start"
        style="margin-top: 3rem;"
      >
        
        <!-- Columna Izquierda: Comienza alineada a 3rem del título -->
        <div>
          <p 
            class="text-sm sm:text-base text-[#5A606A]"
            style="font-family: 'Inter', system-ui, sans-serif; font-weight: 300; line-height: 1.8; color: #5A606A;"
          >
            {t.intro.col1}
          </p>
        </div>

        <!-- Columna Derecha: Desplazamiento asimétrico -->
        <div class="md:translate-y-11 lg:translate-y-12">
          <p 
            class="text-sm sm:text-base text-[#5A606A]"
            style="font-family: 'Inter', system-ui, sans-serif; font-weight: 300; line-height: 1.8; color: #5A606A;"
          >
            {t.intro.col2}
          </p>
        </div>

      </div>

    </div>

    <!-- Fina Barra Divisoria Minimalista -->
    <div class="w-full h-[1px] bg-gray-200/70 my-20 sm:my-28" aria-hidden="true"></div>

    <!-- BLOQUE 2: Arquitectura y Diseño 3D + Especialidades -->
    <div class="fade-up">
      
      <!-- Cabecera de Bloque 2 -->
      <div class="max-w-3xl text-left mb-12 sm:mb-16">
        
        <!-- Antetítulo de Bloque 2 -->
        <span 
          class="text-[10px] sm:text-[11px] font-normal uppercase text-[#C5A880] block mb-5 select-none"
          style="letter-spacing: 0.28em; color: #C5A880;"
        >
          {t.intro.eyebrow2}
        </span>

        <!-- Título H2 Bloque 2 -->
        <h2 
          class="text-[#1E2229]"
          style="font-size: clamp(2rem, 4.2vw, 3.15rem); line-height: 1.1; color: #1E2229;"
        >
          {t.intro.title2}
        </h2>

        <!-- Texto Descriptivo con line-height 1.8 y font-weight 300 -->
        <p 
          class="text-sm sm:text-base text-[#5A606A] max-w-2xl"
          style="font-family: 'Inter', system-ui, sans-serif; font-weight: 300; line-height: 1.8; color: #5A606A; margin-top: 2.25rem;"
        >
          {t.intro.desc2}
        </p>

      </div>

      <!-- Listado de Especialidades Minimalista -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-14 lg:gap-x-20 gap-y-10 pt-10 border-t border-gray-200/70 text-left">
        {t.intro.specialties.map((item) => (
          <div class="space-y-2">
            <span 
              class="text-xs font-normal tracking-[0.22em] uppercase text-[#C5A880] block"
              style="letter-spacing: 0.22em; color: #C5A880;"
            >
              {item.title}
            </span>
            <p 
              class="text-sm text-[#5A606A] leading-[1.75]"
              style="font-family: 'Inter', system-ui, sans-serif; font-weight: 300; line-height: 1.75; color: #5A606A;"
            >
              {item.desc}
            </p>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
