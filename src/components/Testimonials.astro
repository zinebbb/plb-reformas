---
const reviews = [
  {
    quote: "Reformamos el piso entero de 90m². Cumplieron la fecha pactada al día exacto, el presupuesto no varió ni un euro y la iluminación LED indirecta ha transformado por completo la casa.",
    author: "Familia Gómez R.",
    project: "Reforma Integral en Residencial",
    rating: 5,
    tag: "Plazos cumplidos"
  },
  {
    quote: "La cocina quedó impecable. Nos asesoraron en cada detalle de la distribución y los materiales de la encimera. Muy limpios durante toda la obra y respetuosos con los vecinos.",
    author: "Elena & Marcos",
    project: "Cocina de Diseño y Barra",
    rating: 5,
    tag: "Limpieza y detalle"
  },
  {
    quote: "Gran seriedad y profesionalidad. Cambiamos dos baños y suelo completo. El jefe de obra estuvo siempre disponible para cualquier consulta y la garantía nos dio total tranquilidad.",
    author: "David M.",
    project: "Baños y Pavimento Porcelánico",
    rating: 5,
    tag: "Trato profesional"
  }
];
---

<section class="py-24 bg-[#FAF8F5] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="fade-up text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-semibold tracking-widest uppercase text-[#9C7334]">Opiniones y Experiencias</span>
      <h2 class="text-3xl sm:text-4xl font-serif text-[#1F1D1A] mt-2 mb-3">
        La tranquilidad de nuestros clientes
      </h2>
      <p class="text-[#57534E] text-sm sm:text-base leading-relaxed">
        El 85% de nuestros proyectos provienen de recomendaciones directas de familias que han confiado en nuestro equipo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev, idx) => (
        <div 
          class={`fade-up delay-${(idx + 1) * 100} bg-white p-8 rounded-3xl border border-[#EAE3D7] shadow-xs flex flex-col justify-between hover:shadow-md hover:border-[#B58C42]/50 transition-all duration-300`}
        >
          <div>
            <!-- Stars & Tag -->
            <div class="flex items-center justify-between mb-5">
              <div class="flex gap-1 text-[#B58C42] text-xs">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
              <span class="text-[11px] font-semibold text-[#9C7334] bg-[#FAF8F5] px-2.5 py-0.5 rounded-full border border-[#EAE3D7]">
                {rev.tag}
              </span>
            </div>

            <!-- Quote -->
            <p class="text-xs sm:text-sm text-[#57534E] leading-relaxed italic mb-6">
              "{rev.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-4 border-t border-[#F4EFE8]">
            <div class="font-semibold text-sm text-[#1F1D1A]">{rev.author}</div>
            <div class="text-xs text-[#78716C] mt-0.5">{rev.project}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
