---
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-black/40 backdrop-blur-md text-white border-b border-white/10">
  
  <!-- Top Micro-bar -->
  <div class="hidden sm:block border-b border-white/10 bg-black/20 text-xs py-1.5 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-white/80">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
          </svg>
          <span>Benidorm · Altea · Calpe · Costa Blanca</span>
        </span>
        <span class="text-white/40">|</span>
        <span>Proyectos Llave en Mano & Reformas Integrales</span>
      </div>
      <div>
        <a href="tel:+34600000000" class="hover:text-gold-500 transition-colors font-medium flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>+34 600 000 000</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 sm:py-4 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group" aria-label="PLB Reformas, inicio">
      <div class="p-1 bg-white rounded-md shadow-sm transition-transform duration-300 group-hover:scale-105">
        <img 
          src="/images/logo.jpeg" 
          alt="PLB Reformas Premium S.L." 
          class="h-10 sm:h-11 w-auto object-contain"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-extrabold tracking-wider text-white uppercase leading-tight">PLB</span>
        <span class="text-[9px] sm:text-[10px] font-semibold tracking-widest text-gold-500 uppercase">Reformas Benidorm</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center space-x-6 text-xs font-bold tracking-wider uppercase text-white/90">
      <a href="#servicios" class="hover:text-gold-500 transition-colors">Servicios</a>
      <a href="#antes-despues" class="hover:text-gold-500 transition-colors">Antes y Después</a>
      <a href="#proyectos" class="hover:text-gold-500 transition-colors">Vídeos</a>
      <a href="#proceso" class="hover:text-gold-500 transition-colors">Proceso</a>
      <a href="#garantias" class="hover:text-gold-500 transition-colors">Garantías</a>
      <a href="#calculadora" class="hover:text-gold-500 transition-colors">Calculadora</a>
      <a href="#testimonios" class="hover:text-gold-500 transition-colors">Opiniones</a>
      <a href="#contacto" class="hover:text-gold-500 transition-colors">Contacto</a>
    </nav>

    <!-- Right Header CTA -->
    <div class="flex items-center gap-3">
      <a 
        href="#contacto" 
        class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-sm text-xs font-bold uppercase tracking-wider text-black bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:from-gold-500 hover:to-gold-400 shadow-md transition-all duration-300 transform hover:-translate-y-0.5"
      >
        Obtener Presupuesto!
      </a>

      <!-- Mobile Menu Button -->
      <button 
        type="button" 
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-sm border border-white/20 text-white hover:text-gold-500 transition-colors cursor-pointer"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#0f1115]/98 text-white px-6 py-6 space-y-4">
    <a href="#servicios" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Servicios</a>
    <a href="#antes-despues" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Antes y Después</a>
    <a href="#proyectos" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Vídeos de Obras</a>
    <a href="#proceso" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Cómo Trabajamos</a>
    <a href="#garantias" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Garantías</a>
    <a href="#calculadora" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Calculadora de Presupuesto</a>
    <a href="#testimonios" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Opiniones</a>
    <a href="#contacto" class="mobile-nav-link block text-sm font-bold uppercase tracking-wider hover:text-gold-500">Contacto</a>
    <div class="pt-3">
      <a 
        href="#contacto" 
        class="block w-full py-3 rounded-sm text-center text-xs font-bold uppercase tracking-wider text-black bg-gold-500"
      >
        Obtener Presupuesto!
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.add('bg-black/90', 'shadow-lg');
      header.classList.remove('bg-black/40');
    } else {
      header.classList.remove('bg-black/90', 'shadow-lg');
      header.classList.add('bg-black/40');
    }
  }, { passive: true });

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    links.forEach(l => {
      l.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
