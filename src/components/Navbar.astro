---
---

<header class="sticky top-0 z-50 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-[#EAE3D7] transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3.5 group">
        <div class="p-1.5 bg-white rounded-xl shadow-xs border border-[#EAE3D7] transition-transform duration-300 group-hover:scale-105">
          <img 
            src="/images/logo.jpeg" 
            alt="Logo PLB Reformas Premium" 
            class="h-11 w-auto object-contain"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-wider text-[#1F1D1A]">PLB</span>
          <span class="text-[11px] font-semibold tracking-widest text-[#9C7334] uppercase -mt-0.5">Reformas Premium</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-[#4A4641]">
        <a href="#servicios" class="hover:text-[#B58C42] transition-colors">Servicios</a>
        <a href="#obras" class="hover:text-[#B58C42] transition-colors">Vídeos de Obras</a>
        <a href="#proceso" class="hover:text-[#B58C42] transition-colors">Nuestro Proceso</a>
        <a href="#garantias" class="hover:text-[#B58C42] transition-colors">Garantías</a>
        <a href="#contacto" class="hover:text-[#B58C42] transition-colors">Contacto</a>
      </nav>

      <!-- Right Contact Action -->
      <div class="flex items-center gap-4">
        <a 
          href="tel:+34600000000" 
          class="hidden lg:flex items-center gap-2 text-xs font-semibold text-[#4A4641] hover:text-[#B58C42] transition-colors"
        >
          <svg class="w-4 h-4 text-[#B58C42]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>600 000 000</span>
        </a>

        <a 
          href="#contacto" 
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-[#1F1D1A] hover:bg-[#B58C42] shadow-sm hover:shadow-md transition-all duration-300"
        >
          Solicitar Presupuesto
        </a>
      </div>

    </div>
  </div>
</header>
